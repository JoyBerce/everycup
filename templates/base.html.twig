{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}every cup. | G. Tolentino Manila{% endblock %}</title>
    <link rel="icon" type="image/jpeg" href="{{ asset('images/favicon.jpg') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false
            },
            theme: {
                extend: {
                    colors: {
                        brandYellow: '#facc15',
                        brandYellowLight: '#fef08a',
                        brandDark: '#1c1917',
                        brandCardBg: '#ffffff',
                        brandCardText: '#1c1917'
                    }
                }
            }
        }
    </script>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .main-navbar {
            position: sticky !important;
            top: 0 !important;
            z-index: 1050 !important;
            width: 100%;
            background-color: #facc15 !important;
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }

        .main-navbar .container-fluid {
            display: flex;
            align-items: center;
        }

        .main-navbar .navbar-brand {
            color: #1c1917 !important;
            display: flex !important;
            align-items: center;
            visibility: visible !important;
            opacity: 1 !important;
        }

        .main-navbar .navbar-nav {
            display: flex;
        }

        .main-navbar .nav-link {
            color: #1c1917 !important;
            font-weight: 700 !important;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            transition: all 0.2s ease;
            visibility: visible !important;
            opacity: 1 !important;
        }

        .main-navbar .nav-link:hover {
            color: #000000 !important;
            opacity: 0.7 !important;
        }

        .main-navbar .nav-link.active {
            border-bottom: 2px solid #1c1917;
        }

        .main-navbar .navbar-toggler {
            border: 2px solid #1c1917 !important;
            padding: 6px 9px;
            box-shadow: none !important;
            background-color: transparent !important;
        }

        .main-navbar .navbar-toggler:focus {
            box-shadow: none !important;
        }

        .main-navbar .navbar-toggler-icon {
            width: 1.5em;
            height: 1.5em;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='%231c1917' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") !important;
        }

        @media (max-width: 991.98px) {
            .main-navbar .navbar-collapse {
                padding-top: 15px;
                padding-bottom: 10px;
            }

            .main-navbar .navbar-nav {
                gap: 4px;
            }

            .main-navbar .nav-link {
                padding: 10px 8px !important;
            }
        }
    </style>
</head>

<body class="bg-brandYellow text-brandDark antialiased selection:bg-brandDark selection:text-brandYellow d-flex flex-column min-vh-100">

    <!-- Fully Visible & Responsive Bootstrap Navbar -->
    <nav class="navbar navbar-expand-lg main-navbar border-bottom border-dark border-opacity-10 px-3 py-3 shadow-sm">

        <div class="container-fluid container-xxl">

            <!-- Brand Logo -->
            <a
                class="navbar-brand d-flex align-items-center gap-2 text-decoration-none m-0"
                href="{{ path('app_home') }}"
            >
                <div class="bg-brandYellow text-brandDark font-black text-xl sm:text-2xl tracking-tighter px-3 py-1 rounded-xl shadow-lg border-2 border-brandDark transform -rotate-2">
                    every<span class="text-brandDark">cup</span>
                </div>
            </a>

            <!-- Mobile Menu Toggle Button -->
            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbarContent"
                aria-controls="mainNavbarContent"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Collapsible Links Container -->
            <div
                class="collapse navbar-collapse justify-content-end"
                id="mainNavbarContent"
            >

                <ul class="navbar-nav align-items-lg-center gap-lg-3 mt-3 mt-lg-0">

                    <li class="nav-item">
                        <a
                            class="nav-link fw-bold text-uppercase tracking-wider text-brandDark px-2 py-1 {% if app.request.attributes.get('_route') == 'app_home' %}active border-bottom border-2 border-brandDark{% endif %}"
                            href="{{ path('app_home') }}"
                        >
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link fw-bold text-uppercase tracking-wider text-brandDark px-2 py-1 {% if app.request.attributes.get('_route') == 'app_menu' %}active border-bottom border-2 border-brandDark{% endif %}"
                            href="{{ path('app_menu') }}"
                        >
                            Menu
                        </a>
                    </li>

                    <!-- Locations link removed from here -->

                    <li class="nav-item">
                        <a
                            class="nav-link fw-bold text-uppercase tracking-wider text-brandDark px-2 py-1 {% if app.request.attributes.get('_route') == 'app_delivery' %}active border-bottom border-2 border-brandDark{% endif %}"
                            href="{{ path('app_delivery') }}"
                        >
                            Delivery
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link fw-bold text-uppercase tracking-wider text-brandDark px-2 py-1 {% if app.request.attributes.get('_route') == 'app_faq' %}active border-bottom border-2 border-brandDark{% endif %}"
                            href="{{ path('app_faq') }}"
                        >
                            FAQ
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <main class="flex-grow-1">

        {% block body %}{% endblock %}

    </main>

    <footer class="bg-brandDark text-white py-12 border-top border-white/10 text-center mt-auto">

        <div class="container-xxl px-4 space-y-4">

            <div class="bg-brandYellow text-brandDark font-black text-xl tracking-tighter d-inline-block px-4 py-1.5 rounded-2xl shadow border-2 border-brandDark">
                every cup
            </div>

            <p class="text-sm mb-1 font-medium">
                &copy; {{ "now"|date("Y") }} every cup. All rights reserved.
            </p>

            <p class="text-xs text-brandYellow/80 font-semibold mb-0">
                Metro Manila District Suites • G. Tolentino St, Sampaloc, Manila (UST)
            </p>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>