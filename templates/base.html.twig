<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}every cup. | G. Tolentino Manila{% endblock %}</title>

    <meta name="description" content="{% block meta_description %}Every Cup - Your cup, your story. Enjoy freshly prepared coffee and refreshing drinks at G. Tolentino Street, Sampaloc, Manila.{% endblock %}">

    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false
            },
            theme: {
                extend: {
                    colors: {
                        brandYellow: '#facc15',
                        brandYellowLight: '#fef08a',
                        brandCream: '#f8f5ec',
                        brandDark: '#1c1917',
                        brandCardBg: '#ffffff',
                        brandCardText: '#1c1917'
                    }
                }
            }
        };
    </script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- GSAP (falls back to the CSS animations if it fails to load) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script>
        if (window.gsap && window.ScrollTrigger) {
            gsap.registerPlugin(ScrollTrigger);
            document.documentElement.classList.add('gsap-ready');
        }
    </script>

    <!-- Home CSS -->
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">

    {% block stylesheets %}{% endblock %}
</head>

<body class="bg-brandCream text-brandDark antialiased d-flex flex-column min-vh-100">

    <!-- COFFEE-LEVEL SCROLL PROGRESS -->
    <div class="coffee-progress" aria-hidden="true"><span id="coffeeProgressFill"></span></div>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg main-navbar shadow-sm">

        <div class="container-fluid container-xxl px-4">

            <!-- BRAND -->
            <a class="navbar-brand d-flex align-items-center gap-2"
               href="{{ path('app_home') }}">

                <img src="{{ asset('images/logo.png') }}"
                     alt="Every Cup Logo"
                     class="navbar-logo">

                <span class="navbar-brand-text">
                    every cup<span>.</span>
                </span>

            </a>

            <!-- MOBILE TOGGLE -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbarContent"
                    aria-controls="mainNavbarContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- NAVIGATION -->
            <div class="collapse navbar-collapse justify-content-end"
                 id="mainNavbarContent">

                <ul class="navbar-nav align-items-lg-center gap-lg-1 mt-3 mt-lg-0">

                    <li class="nav-item">
                        <a class="nav-link"
                           href="{{ path('app_home') }}#home">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="{{ path('app_menu') }}">
                            Menu
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="{{ path('app_visit') }}">
                            Visit Us
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}#contact">
                            Contact
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_book_bar') }}">
                            Book the Bar
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_order_online') }}">
                            Delivery
                        </a>
                    </li>

                    <li class="nav-item ms-lg-2">
                        <a class="navbar-order-btn"
                           href="{{ path('app_order_online') }}">
                            FIND YOUR CUP
                            <span>↗</span>
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- MAIN CONTENT -->
    <main class="flex-grow-1">

        {% block body %}{% endblock %}

    </main>

    <!-- FOOTER -->
    <footer class="main-footer">

        <div class="container-xxl px-4">

            <div class="row gy-5">

                <div class="col-lg-5">

                    <div class="footer-brand">

                        <img src="{{ asset('images/logo.png') }}"
                             alt="Every Cup Logo">

                        <span>every cup<span>.</span></span>

                    </div>

                    <p class="footer-description">
                        Your cup, your story. Every moment deserves a
                        little something special. Discover your favorite
                        coffee and make every sip count.
                    </p>

                </div>

                <div class="col-6 col-lg-2">

                    <h5>EXPLORE</h5>

                    <a href="{{ path('app_home') }}#home">Home</a>
                    <a href="{{ path('app_home') }}#experience">Our Experience</a>
                    <a href="{{ path('app_home') }}#menu">Our Menu</a>
                    <a href="{{ path('app_home') }}#visit">Visit Us</a>

                </div>

                <div class="col-6 col-lg-2">

                    <h5>DISCOVER</h5>

                    <a href="{{ path('app_home') }}#story">Our Story</a>
                    <a href="{{ path('app_home') }}#menu">Best Sellers</a>
                    <a href="{{ path('app_home') }}#visit">Location</a>

                </div>

                <div class="col-lg-3">

                    <h5>FIND US</h5>

                    <p>
                        G. Tolentino Street,<br>
                        Sampaloc, Manila,<br>
                        Philippines
                    </p>

                    <a href="https://www.google.com/maps/search/?api=1&query=G.+Tolentino+Street+Sampaloc+Manila"
                       target="_blank"
                       rel="noopener noreferrer">
                        GET DIRECTIONS ↗
                    </a>

                </div>

            </div>

            <div class="footer-bottom">

                <p>
                    © {{ "now"|date("Y") }} every cup. All rights reserved.
                </p>

                <p>
                    MADE FOR EVERY MOMENT. MADE FOR EVERY CUP.
                </p>

            </div>

        </div>

    </footer>

    <!-- BOOTSTRAP -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            var fill = document.getElementById('coffeeProgressFill');
            if (!fill) return;
            var ticking = false;
            function update() {
                var max = document.documentElement.scrollHeight - window.innerHeight;
                fill.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, window.scrollY / max) : 0) + ')';
                ticking = false;
            }
            window.addEventListener('scroll', function () {
                if (!ticking) { ticking = true; requestAnimationFrame(update); }
            }, { passive: true });
            window.addEventListener('resize', update);
            update();
        })();
    </script>

    {% block javascripts %}{% endblock %}

</body>
</html>