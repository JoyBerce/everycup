{# templates/home/contact.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<section class="py-24 bg-white text-brandDark">
    <div class="container-xxl px-4">
        <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
            <span class="bg-brandDark text-brandYellow text-xs font-black uppercase tracking-widest px-3.5 py-1.5 rounded-full shadow">Get In Touch</span>
            <h2 class="text-4xl font-extrabold tracking-tight text-brandDark">Contact Us</h2>
            <div class="w-16 h-1.5 bg-brandDark mx-auto rounded-pill"></div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="bg-brandYellow rounded-3xl p-8 shadow-xl border-2 border-brandDark">
                    <form class="space-y-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-brandDark">Your Name</label>
                                <input type="text" class="form-control rounded-xl p-3 border-2 border-brandDark shadow-sm" placeholder="John Doe">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-brandDark">Email / Phone</label>
                                <input type="text" class="form-control rounded-xl p-3 border-2 border-brandDark shadow-sm" placeholder="juan@example.com">
                            </div>
                        </div>
                        <div>
                            <label class="form-label fw-bold text-brandDark">Message / Inquiry</label>
                            <textarea rows="4" class="form-control rounded-xl p-3 border-2 border-brandDark shadow-sm" placeholder="How can we help you today?"></textarea>
                        </div>
                        <button type="submit" class="btn bg-brandDark text-brandYellow fw-bold px-5 py-3 rounded-xl w-100 shadow-lg hover:bg-black">
                            Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}