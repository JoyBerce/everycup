{# templates/home/delivery.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<section class="py-24 bg-brandDark text-white">
    <div class="container-xxl px-4">
        <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
            <span class="bg-brandYellow text-brandDark text-xs font-black uppercase tracking-widest px-3.5 py-1.5 rounded-full shadow">Fast Ordering</span>
            <h2 class="text-4xl font-extrabold tracking-tight text-white">Delivery Services</h2>
            <div class="w-16 h-1.5 bg-brandYellow mx-auto rounded-pill"></div>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="bg-white/10 p-6 rounded-3xl border border-white/20 text-center space-y-3 backdrop-blur-sm">
                    <div class="text-4xl">🛵</div>
                    <h4 class="text-xl font-bold text-brandYellow">GrabFood Delivery</h4>
                    <p class="text-gray-300 text-sm">Order straight from your doorstep using GrabFood within the UST Sampaloc area.</p>
                    <a href="#" class="btn bg-brandYellow text-brandDark fw-bold px-4 py-2 rounded-xl text-sm w-100">Order via Grab</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="bg-white/10 p-6 rounded-3xl border border-white/20 text-center space-y-3 backdrop-blur-sm">
                    <div class="text-4xl">🐼</div>
                    <h4 class="text-xl font-bold text-brandYellow">Foodpanda</h4>
                    <p class="text-gray-300 text-sm">Find us on Foodpanda for quick discounts and reliable daily beverage dispatch.</p>
                    <a href="#" class="btn bg-brandYellow text-brandDark fw-bold px-4 py-2 rounded-xl text-sm w-100">Order via Panda</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="bg-white/10 p-6 rounded-3xl border border-white/20 text-center space-y-3 backdrop-blur-sm">
                    <div class="text-4xl">📞</div>
                    <h4 class="text-xl font-bold text-brandYellow">Direct Pickup / SMS</h4>
                    <p class="text-gray-300 text-sm">Text or call us ahead for fast counter pickup without waiting in line.</p>
                    <a href="tel:09616367870" class="btn bg-brandYellow text-brandDark fw-bold px-4 py-2 rounded-xl text-sm w-100">Call 0961 636 7870</a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}