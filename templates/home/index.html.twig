        let hovering = false, busy = false, back;

        const settle = function () {
            back = gsap.timeline({ onComplete: function () { gsap.set(coffee, { y: HIDE, opacity: 1 }); busy = false; } })
                .to(coffee, { opacity: 0, duration: 1.6, ease: 'power2.inOut' }, 0)
                .to(tints,  { opacity: 0, duration: 1.6, ease: 'power2.inOut' }, 0);
