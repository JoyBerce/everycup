<script>

document.addEventListener('DOMContentLoaded', function () {

    /* =========================================
       LOADING SCREEN
    ========================================= */

    const loader = document.getElementById('coffeeLoader');

    if (loader) {

        document.body.classList.add('loading-active');

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const minShow = reducedMotion ? 700 : 5200;
        const startedAt = performance.now();
        let loaderDone = false;

        const finishLoader = function () {

            if (loaderDone) return;
            loaderDone = true;

            loader.classList.add('loader-hidden');

            document.body.classList.remove('loading-active');

            setTimeout(function () {
                loader.remove();
            }, 900);

        };

        // Wait for the page AND for the cup animation to finish its story.
        if (document.readyState === 'complete') {
            setTimeout(finishLoader, minShow);
        } else {
            window.addEventListener('load', function () {
                setTimeout(finishLoader, Math.max(0, minShow - (performance.now() - startedAt)));
            }, { once: true });
        }

        setTimeout(finishLoader, minShow + 3000);

    }


    /* =========================================
       SCROLL REVEAL
    ========================================= */

    const revealElements = document.querySelectorAll('.reveal');

    if (window.gsap && window.ScrollTrigger) {

        // GSAP scroll reveal: each group eases up with a staggered, weighty settle
        gsap.set(revealElements, { transition: 'none' });

        ScrollTrigger.batch(revealElements, {
            start: 'top 92%',
            once: true,
            onEnter: function (batch) {
                gsap.to(batch, {
                    opacity: 1, y: 0, duration: 1, ease: 'power3.out', stagger: 0.12, overwrite: true,
                    onComplete: function () {
                        batch.forEach(function (el) {
                            el.classList.add('revealed');
                            gsap.set(el, { clearProps: 'opacity,transform,transition' });
                        });
                    }
                });
            }
        });

    } else if ('IntersectionObserver' in window) {

        const revealObserver = new IntersectionObserver(function (entries) {

            entries.forEach(function (entry) {

                if (entry.isIntersecting) {

                    entry.target.classList.add('revealed');

                    revealObserver.unobserve(entry.target);

                }

            });

        }, {
            threshold: 0.12,
            rootMargin: '0px 0px -40px 0px'
        });

        revealElements.forEach(function (element) {
            revealObserver.observe(element);
        });

    } else {

        revealElements.forEach(function (element) {
            element.classList.add('revealed');
        });

    }


    /* =========================================
       NAVBAR SCROLL EFFECT
    ========================================= */

    const navbar = document.querySelector('.main-navbar');

    function updateNavbar() {

        if (!navbar) return;

        if (window.scrollY > 50) {
            navbar.classList.add('navbar-scrolled');
        } else {
            navbar.classList.remove('navbar-scrolled');
        }

    }

    window.addEventListener('scroll', updateNavbar, { passive: true });

    updateNavbar();


    /* =========================================
       CLOSE MOBILE MENU AFTER CLICK
    ========================================= */

    document.querySelectorAll('#mainNavbarContent .nav-link').forEach(function (link) {

        link.addEventListener('click', function () {

            const menu = document.getElementById('mainNavbarContent');

            if (menu && menu.classList.contains('show')) {

                const collapse = bootstrap.Collapse.getOrCreateInstance(menu);

                collapse.hide();

            }

        });

    });

    /* =========================================
       ORDER TRAY
    ========================================= */
    const orderTray = document.getElementById('orderTray');
    const orderItems = document.getElementById('orderItems');
    const orderTotal = document.getElementById('orderTotal');
    const order = {};
    const peso = value => 'â‚±' + Number(value).toLocaleString('en-PH');

    function renderOrder() {
        const entries = Object.values(order);
        if (!entries.length) {
            orderItems.innerHTML = '<p class="empty-order">Your tray is waiting for its first cup.</p>';
            orderTotal.textContent = 'â‚±0';
            return;
        }
        let total = 0;
        orderItems.innerHTML = entries.map(item => {
            total += item.price * item.qty;
            return `<div class="order-line"><strong>${item.name}</strong><div class="qty-control"><button type="button" data-change="-1" data-item="${item.name}">âˆ’</button><span>${item.qty}</span><button type="button" data-change="1" data-item="${item.name}">+</button></div><span>${peso(item.price * item.qty)}</span></div>`;
        }).join('');
        orderTotal.textContent = peso(total);
        orderItems.querySelectorAll('[data-change]').forEach(button => button.addEventListener('click', function () {
            order[this.dataset.item].qty += Number(this.dataset.change);
            if (order[this.dataset.item].qty <= 0) delete order[this.dataset.item];
            renderOrder();
        }));
    }

    document.querySelectorAll('.add-to-order').forEach(button => button.addEventListener('click', function () {
        const name = this.dataset.name;
        const price = Number(this.dataset.price.replace(/[^0-9.]/g, '')) || 0;
        order[name] = order[name] || { name, price, qty: 0 };
        order[name].qty += 1;
        flyBean(this);
        renderOrder();
        orderTray.classList.add('is-open');
    }));
    document.querySelector('.tray-close')?.addEventListener('click', () => orderTray.classList.remove('is-open'));
    document.getElementById('orderForm')?.addEventListener('submit', function (event) {
        event.preventDefault();
        if (!Object.keys(order).length) return;
        document.getElementById('orderStatus').textContent = 'Order received â€” weâ€™ll have it ready for you.';
        this.reset();
    });

    /* =========================================
       BAR BOOKING
    ========================================= */
    const dateInput = document.getElementById('bookingDate');
    if (dateInput) dateInput.min = new Date().toISOString().split('T')[0];
    document.querySelectorAll('.time-slot').forEach(slot => slot.addEventListener('click', function () {
        document.querySelectorAll('.time-slot').forEach(item => item.classList.remove('active'));
        this.classList.add('active');
    }));
    document.getElementById('bookingForm')?.addEventListener('submit', function (event) {
        event.preventDefault();
        const date = new Date(dateInput.value + 'T12:00:00');
        document.getElementById('bookingStatus').textContent = `Lovely â€” your ${date.toLocaleDateString('en-PH', { month: 'short', day: 'numeric' })} bar request is on its way.`;
    });


    /* =========================================
       HERO PARALLAX (cups and beans follow the cursor)
    ========================================= */
    const parallaxStage = document.getElementById('heroCupStage');
    const parallaxArea = document.querySelector('.hero-visual');

    if (parallaxStage && parallaxArea &&
        window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {

        parallaxArea.addEventListener('pointermove', function (event) {
            const box = parallaxStage.getBoundingClientRect();
            const mx = Math.max(-1.5, Math.min(1.5, ((event.clientX - box.left) / box.width - 0.5) * 2));
            const my = Math.max(-1.5, Math.min(1.5, ((event.clientY - box.top) / box.height - 0.5) * 2));
            parallaxStage.style.setProperty('--mx', mx.toFixed(3));
            parallaxStage.style.setProperty('--my', my.toFixed(3));
        });

        parallaxArea.addEventListener('pointerleave', function () {
            parallaxStage.style.setProperty('--mx', 0);
            parallaxStage.style.setProperty('--my', 0);
        });

    }


    /* =========================================
       A COFFEE BEAN FLIES TO THE TRAY ON "ADD"
    ========================================= */
    const BEAN_SVG = '<svg viewBox="-13 -18 26 36" width="22" height="30" xmlns="http://www.w3.org/2000/svg"><ellipse rx="10.5" ry="15.5" fill="#4a2410"/><path d="M-1.5,-14C5,-5-6,4 1.5,14" fill="none" stroke="#150a05" stroke-width="2" stroke-linecap="round"/><ellipse cx="-4" cy="-6" rx="2.5" ry="5" fill="#fff" opacity=".2"/></svg>';

    function flyBean(fromElement) {

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const box = fromElement.getBoundingClientRect();
        const bean = document.createElement('div');
        bean.innerHTML = BEAN_SVG;
        bean.style.cssText = 'position:fixed;left:0;top:0;z-index:1100;pointer-events:none;';
        document.body.appendChild(bean);

        const startX = box.left + box.width / 2 - 11;
        const startY = box.top + box.height / 2 - 15;
        const endX = window.innerWidth - 90;
        const endY = window.innerHeight - 90;

        bean.animate([
            { transform: 'translate(' + startX + 'px,' + startY + 'px) scale(1) rotate(0deg)', opacity: 1 },
            { transform: 'translate(' + ((startX + endX) / 2) + 'px,' + (Math.min(startY, endY) - 90) + 'px) scale(1.15) rotate(220deg)', opacity: 1, offset: 0.45 },
            { transform: 'translate(' + endX + 'px,' + endY + 'px) scale(0.45) rotate(520deg)', opacity: 0.2 }
        ], { duration: 750, easing: 'cubic-bezier(.4,.1,.3,1)' }).onfinish = function () {
            bean.remove();
        };

    }

});

</script>


<script>
/* =========================================
       MOBILE TAP SUPPORT FOR HERO CUP POUR
    ========================================= */
    const heroCupStage = document.getElementById('heroCupStage');
    if (heroCupStage) {
        const heroSection = document.querySelector('.hero-section');
        const togglePour = function () {
            heroCupStage.classList.toggle('is-pouring');
            if (heroSection) {
                heroSection.classList.toggle('cup-pouring', heroCupStage.classList.contains('is-pouring'));
            }
        };
        heroCupStage.addEventListener('click', togglePour);
        heroCupStage.addEventListener('keydown', function (event) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                togglePour();
            }
        });
    }
</script>

<!-- ===================================================== -->
<!-- GSAP: LOADER PHYSICS, CHOCOLATE POUR, SCROLL + TILT -->
<!-- ===================================================== -->

<script>
(function () {

    if (!window.gsap) return;

    const $  = (s, r) => (r || document).querySelector(s);
    const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.globalTimeline.timeScale(20);
    }

    /* =========================================
       LOADER: gravity, bounce, ballistic droplets
    ========================================= */
    if ($('#coffeeLoader')) {

        gsap.set('.lc-rig',    { opacity: 0, y: 90, scale: 0.88, svgOrigin: '150 330' });
        gsap.set('.lc-shadow', { opacity: 0, scale: 0.5, svgOrigin: '150 327' });
        gsap.set('.loader-logo', { opacity: 0, y: 120, scale: 0.2, rotation: -20 });
        gsap.set('.lc-bean',   { opacity: 0, scale: 0.2, rotation: -30, y: 0 });
        gsap.set('.lc-lid',    { svgOrigin: '150 150' });
        gsap.set('.lc-ripple', { opacity: 0, svgOrigin: '150 157' });
        gsap.set('.lc-crema',  { opacity: 0 });
        gsap.set('.loader-caption', { opacity: 0, xPercent: -50, y: 12 });

        const steam = function () {
            $$('.lc-steam path').forEach(function (p, i) {
                gsap.set(p, { transformOrigin: '50% 100%' });
                gsap.fromTo(p, { y: 14, scaleY: 0.6, x: 0 },
                    { y: -34, scaleY: 1.2, x: 8, duration: 3.4, ease: 'none', repeat: -1, delay: i * 0.55 });
                gsap.fromTo(p, { opacity: 0 },
                    { opacity: 0.6, duration: 1.7, ease: 'sine.out', yoyo: true, repeat: -1, delay: i * 0.55, immediateRender: false });
            });
        };

        const splash = function () {

            gsap.timeline().to('.lc-surface', { y: 1.6, duration: 0.1 })
                           .to('.lc-surface', { y: -2.6, duration: 1.4, ease: 'elastic.out(1,0.35)' });

            $$('.lc-ripple').forEach(function (r, i) {
                gsap.fromTo(r, { scale: 0.12, opacity: 0.9 },
                    { scale: 1.55, opacity: 0, duration: 1.3, ease: 'power2.out', delay: i * 0.16, immediateRender: false });
            });

            $$('.lc-splash .dx').forEach(function (g) {
                const v = function (n) { return parseFloat(g.style.getPropertyValue(n)); };
                const dx = v('--dx') * (0.85 + Math.random() * 0.3), h = v('--h'), d = v('--dur'), dy = g.firstElementChild;
                gsap.timeline({ delay: v('--dl') })
                    .to(g,  { x: dx, duration: d, ease: 'none' }, 0)
                    .fromTo(dy, { opacity: 1, y: 0 }, { y: h, duration: d * 0.48, ease: 'power2.out', immediateRender: false }, 0)
                    .to(dy, { y: 2, duration: d * 0.44, ease: 'power2.in' }, d * 0.48)
                    .to(dy, { opacity: 0, duration: 0.05 }, d * 0.92);
            });

            gsap.to('.lc-crema', { opacity: 0.6, duration: 1, delay: 0.5 });
            gsap.to('.lc-crema', { strokeDashoffset: -148, duration: 6, ease: 'none', repeat: -1, delay: 0.5 });
        };

        gsap.timeline({ defaults: { ease: 'power2.out' } })
            .to('.lc-rig',    { opacity: 1, y: 0, scale: 1, duration: 0.95, ease: 'back.out(1.4)' }, 0.1)
            .to('.lc-shadow', { opacity: 0.38, scale: 1, duration: 0.95 }, 0.1)
            .to('.loader-logo', { opacity: 1, y: 0, scale: 1.14, rotation: 0, duration: 0.6, ease: 'power3.out' }, 0.35)
            .to('.loader-logo', { scale: 1, duration: 0.45, ease: 'elastic.out(1,0.5)' }, 0.95)
            .to('.loader-logo', { scale: 0.16, rotation: 320, opacity: 0, duration: 0.5, ease: 'power2.in' }, 1.55)
            // lid: seal breaks, tilts up, then falls away under gravity
            .to('.lc-lid', { y: -9, rotation: -1.5, duration: 0.18 }, 1.55)
            .to('.lc-lid', { x: 34, y: -50, rotation: 12, duration: 0.42 }, 1.73)
            .to('.lc-lid', { x: 150, y: -4, rotation: 48, opacity: 0, duration: 0.55, ease: 'power2.in' }, 2.15)
            .add(steam, 2.2)
            // bean: pops out of the logo, accelerates, plunges, bobs, sinks
            .to('.lc-bean', { opacity: 1, scale: 1.1, rotation: 0, duration: 0.18 }, 1.85)
            .to('.lc-bean', { y: 166, rotation: 520, duration: 1.06, ease: 'power2.in' }, 2.03)
            .add(splash, 3.09)
            .to('.lc-bean', { y: 200, rotation: 552, duration: 0.16 }, 3.09)
            .to('.lc-bean', { y: 176, rotation: 566, duration: 0.22, ease: 'sine.inOut' }, 3.25)
            .to('.lc-bean', { y: 181, rotation: 572, duration: 0.16, ease: 'sine.in' }, 3.47)
            .to('.lc-bean', { y: 232, rotation: 600, duration: 0.62, ease: 'power1.in' }, 3.63)
            .to('.loader-caption', { opacity: 1, y: 0, duration: 0.8 }, 3.9);
    }

    /* =========================================
       HERO: chocolate pour timeline
    ========================================= */
    const stage = $('#heroCupStage');

    if (stage) {

        const stream = $('.espresso-stream-svg', stage), tint = $('.choco-tint', stage), pool = $('.choco-pool', stage);
        const mound = $('.choco-mound', stage), plumes = $$('.choco-plume', stage);
        const ripples = $$('.choco-ripple', stage), drops = $$('.choco-drop', stage);

        gsap.set(stream, { clipPath: 'inset(0% 0% 100% 0%)' });
        gsap.set(tint,   { '--mix': 0 });
        gsap.set(pool,   { opacity: 0, width: '12%' });
        gsap.set(mound,  { opacity: 0, transformOrigin: '50% 100%' });
        gsap.set(plumes, { opacity: 0, y: -70, scaleY: 0.3, transformOrigin: '50% 0%' });
        gsap.set([ripples, drops], { opacity: 0 });

        const pour = gsap.timeline({ paused: true });

        pour.to(stream, { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.62, ease: 'power2.in' }, 0)      // head falls
            .to(mound,  { opacity: 1, duration: 0.15 }, 0.62)
            .fromTo(mound, { scaleX: 0.86, scaleY: 0.8 }, { scaleX: 1.14, scaleY: 1.18, duration: 0.16, repeat: 12, yoyo: true, ease: 'sine.inOut' }, 0.7)
            .to(pool,   { opacity: 0.85, width: '100%', duration: 2.4, ease: 'power3.out' }, 0.8)
            .to(tint,   { '--mix': 1, duration: 5.2, ease: 'power2.inOut' }, 0.9)                        // milk turns to chocolate
            .to(stream, { clipPath: 'inset(100% 0% 0% 0%)', duration: 0.75, ease: 'power2.in' }, 2.25)  // tail leaves
            .to(mound,  { opacity: 0, duration: 0.4 }, 2.5);

        plumes.forEach(function (p, i) {
            const at = 0.75 + [0, 0.2, 0.45, 0.3][i];
            pour.to(p, { opacity: 1, duration: 0.5 }, at)
                .to(p, { y: 30, scaleY: 1, x: 6, duration: 2.2, ease: 'power1.out' }, at)
                .to(p, { opacity: 0, y: 95, scaleY: 1.15, x: -5, duration: 1.6, ease: 'power1.in' }, at + 2.2);
        });

        ripples.forEach(function (r, i) {
            pour.fromTo(r, { opacity: 0.85, scaleX: 0.25, scaleY: 0.25 },
                { opacity: 0, scaleX: 2.3, scaleY: 1.9, duration: 1.05, ease: 'power2.out', repeat: 2 }, 0.78 + i * 0.17);
        });

        drops.forEach(function (d, i) {
            const dx = parseFloat(getComputedStyle(d).getPropertyValue('--dx')), h = parseFloat(getComputedStyle(d).getPropertyValue('--h'));
            pour.add(
                gsap.timeline({ repeat: 3, repeatRefresh: true })
                    .set(d, { x: 0, y: 0, opacity: 1 })
                    .to(d, { x: function () { return dx * (0.8 + Math.random() * 0.4); }, duration: 0.64, ease: 'none' }, 0)
                    .to(d, { y: h, duration: 0.31, ease: 'power2.out' }, 0)
                    .to(d, { y: 2, duration: 0.33, ease: 'power2.in' }, 0.31)
                    .to(d, { opacity: 0, duration: 0.05 }, 0.59),
                0.8 + i * 0.12);
        });

        let hovering = false, busy = false, back;

        const settle = function () {
            back = gsap.timeline({ onComplete: function () { busy = false; } })
                .to(tint, { '--mix': 0, duration: 1.6, ease: 'power2.inOut' }, 0)
                .to(pool, { opacity: 0, width: '12%', duration: 1, ease: 'power1.in' }, 0);
        };

        pour.eventCallback('onComplete', function () { if (!hovering) settle(); });

        stage.addEventListener('pointerenter', function () {
            hovering = true;
            if (busy && pour.isActive()) return;
            if (back) back.kill();
            busy = true;
            pour.restart();
        });

        stage.addEventListener('pointerleave', function () {
            hovering = false;
            if (busy && !pour.isActive()) settle();
        });
    }

    /* =========================================
       SCROLL: depth parallax on the hero backdrop
    ========================================= */
    if (window.ScrollTrigger && $('.hero-section')) {
        gsap.to('.hero-logo-background', { yPercent: -14, ease: 'none',
            scrollTrigger: { trigger: '.hero-section', start: 'top top', end: 'bottom top', scrub: 0.6 } });
        gsap.to('.hero-background-decoration', { y: 120, ease: 'none',
            scrollTrigger: { trigger: '.hero-section', start: 'top top', end: 'bottom top', scrub: 0.6 } });
    }

    /* =========================================
       MENU CARDS: soft 3D tilt toward the cursor
    ========================================= */
    if (window.matchMedia('(hover: hover)').matches) {
        $$('.menu-card').forEach(function (card) {
            let rx, ry;
            card.addEventListener('pointerenter', function () {
                if (rx) return;
                gsap.set(card, { transformPerspective: 900 });
                rx = gsap.quickTo(card, 'rotationX', { duration: 0.5, ease: 'power3' });
                ry = gsap.quickTo(card, 'rotationY', { duration: 0.5, ease: 'power3' });
            });
            card.addEventListener('pointermove', function (ev) {
                if (!rx) return;
                const b = card.getBoundingClientRect();
                ry(((ev.clientX - b.left) / b.width - 0.5) * 8);
                rx(-((ev.clientY - b.top) / b.height - 0.5) * 8);
            });
            card.addEventListener('pointerleave', function () { if (rx) { rx(0); ry(0); } });
        });
    }

})();
</script>


{% endblock %}
