        const OUTER = [[0,0],[.52,0],[.555,.025],[.565,.08],[.60,.4],[.68,1.0],[.76,1.6],[.82,2.1],[.855,2.42],[.90,2.47],[.935,2.50],[.92,2.525],[.885,2.505]];
