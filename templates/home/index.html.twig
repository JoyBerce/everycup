        });
        stage.addEventListener('pointerleave', function () {
            hovering = false;
            if (busy && !pour.isActive()) settle();
        });
    }
})();
</script>


<!-- ===================================================== -->
<!-- FEATURED MENU ORBIT SCROLL CONTROLLER -->
<!-- ===================================================== -->

<script>
document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('.flavor-orbit-section');
    if (!section) return;

    const flavors = JSON.parse(section.querySelector('[data-orbit-flavors]').textContent);
    const wheel = section.querySelector('[data-orbit-wheel]');
    const nodes = Array.from(section.querySelectorAll('.flavor-orbit-node'));
    const copies = Array.from(section.querySelectorAll('[data-flavor-copy]'));
    const slides = Array.from(section.querySelectorAll('[data-flavor-slide]'));
    const ingredientImages = Array.from(section.querySelectorAll('[data-ingredient-image]'));
    const counter = section.querySelector('[data-flavor-counter]');
    const prevBtn = section.querySelector('[data-flavor-prev]');
    const nextBtn = section.querySelector('[data-flavor-next]');
    const count = flavors.length;
    const stepDeg = 360 / count;
    let activeIndex = 0;
    let currentRotation = 0;
    let rafId = 0;

    section.addEventListener('pointermove', event => {
        const bounds = section.getBoundingClientRect();
        const shiftX = Math.max(-18, Math.min(18, ((event.clientX - bounds.left) / bounds.width - 0.5) * 36));
        const shiftY = Math.max(-14, Math.min(14, ((event.clientY - bounds.top) / bounds.height - 0.5) * 28));
        section.style.setProperty('--art-shift-x', shiftX + 'px');
        section.style.setProperty('--art-shift-y', shiftY + 'px');
    }, { passive: true });
    section.addEventListener('pointerleave', () => {
        section.style.setProperty('--art-shift-x', '0px');
        section.style.setProperty('--art-shift-y', '0px');
    });

    function goToFlavor(targetIndex, smoothScrollToStep) {
        const normalized = ((targetIndex % count) + count) % count;

        if (normalized !== activeIndex) {
            const prevIndex = activeIndex;

            // Shortest angular delta so the orbit wheel never spins wildly backward
            let deltaSteps = normalized - prevIndex;
            if (deltaSteps > count / 2) deltaSteps -= count;
            if (deltaSteps < -count / 2) deltaSteps += count;

            currentRotation -= deltaSteps * stepDeg;
            wheel.style.setProperty('--wheel-rotation', currentRotation + 'deg');

            nodes.forEach((node, idx) => {
                const isNow = idx === normalized;
                node.classList.toggle('is-active', isNow);
                node.setAttribute('aria-pressed', isNow ? 'true' : 'false');
            });

            copies.forEach((copy, idx) => {
                const isNow = idx === normalized;
                copy.classList.toggle('is-active', isNow);
                copy.setAttribute('aria-hidden', isNow ? 'false' : 'true');
            });

            slides.forEach((slide, idx) => {
                slide.classList.remove('is-active', 'is-prev');
                if (idx === normalized) {
                    slide.classList.add('is-active');
                } else if (idx === prevIndex) {
                    slide.classList.add('is-prev');
                }
            });

            ingredientImages.forEach((image, idx) => image.classList.toggle('is-active', idx === normalized));

            const item = flavors[normalized];
            section.style.setProperty('--orbit-accent', item.color);
            section.style.setProperty('--orbit-bg', item.bg);
            if (counter) {
                counter.textContent = (normalized + 1) + ' / ' + count;
            }

            activeIndex = normalized;
        }

        if (smoothScrollToStep) {
            const sectionTop = window.scrollY + section.getBoundingClientRect().top;
            const scrollable = Math.max(1, section.offsetHeight - window.innerHeight);
            const targetScrollY = sectionTop + ((normalized + 0.35) / count) * scrollable;
            window.scrollTo({ top: targetScrollY, behavior: 'smooth' });
        }
    }

    nodes.forEach(node => {
        node.addEventListener('click', function () {
            goToFlavor(Number(this.dataset.flavorIndex), true);
        });
    });

    if (prevBtn) {
        prevBtn.addEventListener('click', function () {
            goToFlavor(activeIndex - 1, true);
        });
    }

    if (nextBtn) {
        nextBtn.addEventListener('click', function () {
            goToFlavor(activeIndex + 1, true);
        });
    }

    function onScrollFrame() {
        rafId = 0;
        const rect = section.getBoundingClientRect();
        const inView = rect.top < window.innerHeight * 0.65 && rect.bottom > window.innerHeight * 0.35;
        section.classList.toggle('is-in-view', inView);

        const scrollable = Math.max(1, rect.height - window.innerHeight);
        const progress = Math.max(0, Math.min(0.9999, -rect.top / scrollable));
        const scrollIndex = Math.floor(progress * count);
        goToFlavor(scrollIndex, false);
    }

    window.addEventListener('scroll', function () {
        if (!rafId) {
            rafId = window.requestAnimationFrame(onScrollFrame);
        }
    }, { passive: true });

    window.addEventListener('resize', onScrollFrame, { passive: true });

    // Initialize first flavor palette
    section.style.setProperty('--orbit-accent', flavors[0].color);
    section.style.setProperty('--orbit-bg', flavors[0].bg);
    onScrollFrame();
});
</script>

