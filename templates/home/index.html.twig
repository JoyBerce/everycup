            }
        });
    }
</script>

<!-- ===================================================== -->
<!-- GSAP: LOADER PHYSICS, CHOCOLATE POUR, SCROLL + TILT -->
<!-- ===================================================== -->

<script>
(function () {

    if (!window.gsap) return;

    const $  = (s, r) => (r || document).querySelector(s);
    const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.globalTimeline.timeScale(20);
    }

    /* =========================================
       LOADER: gravity, bounce, ballistic droplets
    ========================================= */
    if ($('#coffeeLoader')) {

        gsap.set('.lc-rig',    { opacity: 0, y: 90, scale: 0.88, svgOrigin: '150 330' });
        gsap.set('.lc-shadow', { opacity: 0, scale: 0.5, svgOrigin: '150 327' });
        gsap.set('.loader-logo', { opacity: 0, y: 120, scale: 0.2, rotation: -20 });
        gsap.set('.lc-bean',   { opacity: 0, scale: 0.2, rotation: -30, y: 0 });
        gsap.set('.lc-lid',    { svgOrigin: '150 150' });
        gsap.set('.lc-ripple', { opacity: 0, svgOrigin: '150 157' });
        gsap.set('.lc-crema',  { opacity: 0 });
        gsap.set('.loader-caption', { opacity: 0, xPercent: -50, y: 12 });

        const steam = function () {
            $$('.lc-steam path').forEach(function (p, i) {
                gsap.set(p, { transformOrigin: '50% 100%' });
                gsap.fromTo(p, { y: 14, scaleY: 0.6, x: 0 },
                    { y: -34, scaleY: 1.2, x: 8, duration: 3.4, ease: 'none', repeat: -1, delay: i * 0.55 });
                gsap.fromTo(p, { opacity: 0 },
                    { opacity: 0.6, duration: 1.7, ease: 'sine.out', yoyo: true, repeat: -1, delay: i * 0.55, immediateRender: false });
            });
        };

        const splash = function () {

            gsap.timeline().to('.lc-surface', { y: 1.6, duration: 0.1 })
                           .to('.lc-surface', { y: -2.6, duration: 1.4, ease: 'elastic.out(1,0.35)' });

            $$('.lc-ripple').forEach(function (r, i) {
                gsap.fromTo(r, { scale: 0.12, opacity: 0.9 },
                    { scale: 1.55, opacity: 0, duration: 1.3, ease: 'power2.out', delay: i * 0.16, immediateRender: false });
            });

            $$('.lc-splash .dx').forEach(function (g) {
                const v = function (n) { return parseFloat(g.style.getPropertyValue(n)); };
                const dx = v('--dx') * (0.85 + Math.random() * 0.3), h = v('--h'), d = v('--dur'), dy = g.firstElementChild;
                gsap.timeline({ delay: v('--dl') })
                    .to(g,  { x: dx, duration: d, ease: 'none' }, 0)
                    .fromTo(dy, { opacity: 1, y: 0 }, { y: h, duration: d * 0.48, ease: 'power2.out', immediateRender: false }, 0)
                    .to(dy, { y: 2, duration: d * 0.44, ease: 'power2.in' }, d * 0.48)
                    .to(dy, { opacity: 0, duration: 0.05 }, d * 0.92);
            });

            gsap.to('.lc-crema', { opacity: 0.6, duration: 1, delay: 0.5 });
            gsap.to('.lc-crema', { strokeDashoffset: -148, duration: 6, ease: 'none', repeat: -1, delay: 0.5 });
        };

        gsap.timeline({ defaults: { ease: 'power2.out' } })
            .to('.lc-rig',    { opacity: 1, y: 0, scale: 1, duration: 0.95, ease: 'back.out(1.4)' }, 0.1)
            .to('.lc-shadow', { opacity: 0.38, scale: 1, duration: 0.95 }, 0.1)
            .to('.loader-logo', { opacity: 1, y: 0, scale: 1.14, rotation: 0, duration: 0.6, ease: 'power3.out' }, 0.35)
            .to('.loader-logo', { scale: 1, duration: 0.45, ease: 'elastic.out(1,0.5)' }, 0.95)
            .to('.loader-logo', { scale: 0.16, rotation: 320, opacity: 0, duration: 0.5, ease: 'power2.in' }, 1.55)
            // lid: seal breaks, tilts up, then falls away under gravity
            .to('.lc-lid', { y: -9, rotation: -1.5, duration: 0.18 }, 1.55)
            .to('.lc-lid', { x: 34, y: -50, rotation: 12, duration: 0.42 }, 1.73)
            .to('.lc-lid', { x: 150, y: -4, rotation: 48, opacity: 0, duration: 0.55, ease: 'power2.in' }, 2.15)
            .add(steam, 2.2)
            // bean: pops out of the logo, accelerates, plunges, bobs, sinks
            .to('.lc-bean', { opacity: 1, scale: 1.1, rotation: 0, duration: 0.18 }, 1.85)
            .to('.lc-bean', { y: 166, rotation: 520, duration: 1.06, ease: 'power2.in' }, 2.03)
            .add(splash, 3.09)
            .to('.lc-bean', { y: 200, rotation: 552, duration: 0.16 }, 3.09)
            .to('.lc-bean', { y: 176, rotation: 566, duration: 0.22, ease: 'sine.inOut' }, 3.25)
            .to('.lc-bean', { y: 181, rotation: 572, duration: 0.16, ease: 'sine.in' }, 3.47)
            .to('.lc-bean', { y: 232, rotation: 600, duration: 0.62, ease: 'power1.in' }, 3.63)
            .to('.loader-caption', { opacity: 1, y: 0, duration: 0.8 }, 3.9);
    }

    /* =========================================
       HERO: chocolate pour timeline
    ========================================= */
    const stage = $('#heroCupStage');

    if (stage) {

        stage.classList.add('rc-gsap');

        const HIDE = -245, SHOW = -105;
        const stream = $$('.rc-stream', stage), coffee = $('.rc-coffee', stage), tints = $$('.rc-cube-tint', stage);
        const plumes = $$('.rc-plume', stage), ripples = $$('.rc-ripple', stage), drops = $$('.rc-drop', stage);
        const mound = $('.rc-mound', stage), bobs = $$('.rc-cube-bob', stage);

        gsap.set(stream,  { strokeDasharray: '1 1', strokeDashoffset: 1 });
        gsap.set(coffee,  { y: HIDE, opacity: 1 });
        gsap.set(tints,   { opacity: 0 });
        gsap.set(mound,   { opacity: 0, transformOrigin: '50% 100%' });
        gsap.set(plumes,  { opacity: 0, transformOrigin: '50% 0%' });
        gsap.set([ripples, drops], { opacity: 0 });

        const pour = gsap.timeline({ paused: true });

        pour.fromTo(stream, { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.6, ease: 'power2.in' }, 0)      // head falls
            .to(mound, { opacity: 1, duration: 0.12 }, 0.6)
            .fromTo(mound, { scaleX: 0.86, scaleY: 0.8 }, { scaleX: 1.14, scaleY: 1.2, duration: 0.16, repeat: 12, yoyo: true, ease: 'sine.inOut' }, 0.62)
            .fromTo(coffee, { y: HIDE, opacity: 1 }, { y: SHOW, duration: 4.6, ease: 'power2.inOut' }, 0.7)               // coffee layers into the milk
            .to(tints, { opacity: 0.4, duration: 3.2, ease: 'power1.inOut' }, 1)                                          // ice picks up the colour
            .to(stream, { strokeDashoffset: -1, duration: 0.75, ease: 'power2.in' }, 2.35)                               // tail leaves
            .to(mound, { opacity: 0, duration: 0.4 }, 2.6);

        bobs.forEach(function (c, i) {
            pour.fromTo(c, { y: 0, rotation: 0 }, { y: 2.5 + i, rotation: i % 2 ? 4 : -4, duration: 1.1, repeat: 1, yoyo: true, ease: 'sine.inOut', svgOrigin: '0 0' }, 0.7 + i * 0.1);
        });

        plumes.forEach(function (p, i) {
            const at = 0.75 + [0, 0.2, 0.45, 0.3][i];
            pour.fromTo(p, { opacity: 0, y: -20, scaleY: 0.3 }, { opacity: 0.85, y: 16, scaleY: 1, duration: 1.6, ease: 'power1.out' }, at)
