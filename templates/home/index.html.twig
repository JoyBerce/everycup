{% extends 'base.html.twig' %}

{% block title %}
    every cup. | Your Cup, Your Story
{% endblock %}

{% block body %}

<style>
/* =====================================================
   FEATURED MENU — TIRATI-STYLE ORBIT SHOWCASE
===================================================== */
.flavor-orbit-section {
    --orbit-bg: #f6f0e6;
    --orbit-ink: #1f140d;
    --orbit-muted: rgba(31, 20, 13, 0.64);
    --orbit-accent: #b87832;
    --orbit-ring: rgba(31, 20, 13, 0.14);
    --orbit-size: min(72vw, 88vh, 860px);
    position: relative;
    height: 360vh;
    background: var(--orbit-bg);
    color: var(--orbit-ink);
    transition: background-color 0.65s cubic-bezier(0.22, 1, 0.36, 1);
}

.flavor-orbit-section::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 72% 52%, color-mix(in srgb, var(--orbit-accent) 22%, transparent) 0%, transparent 62%);
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 0;
}

.flavor-ingredient-art {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 62%;
    width: clamp(280px, 38vw, 560px);
    height: clamp(280px, 38vw, 560px);
    transform: translate(calc(-50% + var(--art-shift-x, 0px)), calc(-50% + var(--art-shift-y, 0px)));
    pointer-events: none;
    opacity: 0.78;
    transition: transform 0.35s ease-out;
}

.flavor-ingredient-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transform: scale(0.88) rotate(-7deg);
    filter: drop-shadow(0 22px 30px rgba(42, 26, 15, 0.2));
    transition: opacity 0.6s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    animation: ingredient-float 7s ease-in-out infinite;
}

.flavor-ingredient-image.is-active {
    opacity: 0.86;
    transform: scale(1) rotate(0);
}

@keyframes ingredient-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -12px; }
}

.flavor-orbit-section.is-in-view::before {
    opacity: 1;
}

.flavor-orbit-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 640px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(5.5rem, 9vh, 7rem) clamp(1.25rem, 5vw, 4.5rem) clamp(2rem, 4vh, 3rem);
    z-index: 1;
}

.flavor-orbit-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1380px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
}

/* LEFT COLUMN: EDITORIAL TITLE + STACKED FLAVOR COPY */
.flavor-orbit-left {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vh, 2rem);
}

.flavor-section-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--orbit-accent);
    margin: 0;
    transition: color 0.45s ease;
}

.flavor-section-heading {
    font-size: clamp(2.25rem, 4.2vw, 3.85rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--orbit-ink);
    margin: 0.35rem 0 0;
}

.flavor-copy-stack {
    position: relative;
    min-height: clamp(190px, 24vh, 240px);
}

.flavor-copy-item {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(22px);
    pointer-events: none;
    transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
}

.flavor-copy-item.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
}

.flavor-meta-row {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 0.65rem;
}

.flavor-meta-category {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--orbit-muted);
}

.flavor-meta-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--orbit-accent);
    display: inline-block;
}

.flavor-meta-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.24rem 0.72rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--orbit-accent) 16%, transparent);
    color: var(--orbit-ink);
    border: 1px solid color-mix(in srgb, var(--orbit-accent) 36%, transparent);
}

.flavor-item-title {
    font-size: clamp(1.55rem, 2.5vw, 2.25rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin: 0 0 0.75rem;
    color: var(--orbit-ink);
    width: fit-content;
    padding: 0.18em 0.38em 0.22em;
    border-radius: 0.22em;
    background: color-mix(in srgb, var(--orbit-accent) 28%, transparent);
    transition: background-color 0.55s cubic-bezier(0.22, 1, 0.36, 1);
}

.flavor-item-desc {
    font-size: clamp(0.9rem, 1vw, 1rem);
    line-height: 1.5;
    color: var(--orbit-ink);
    max-width: 44ch;
    margin: 0 0 1.1rem;
}

.flavor-item-desc strong {
    font-weight: 800;
    color: var(--orbit-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--orbit-accent) 55%, transparent);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.16em;
}

.flavor-item-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
}

.flavor-price-pill {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--orbit-ink);
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--orbit-ring);
}

.flavor-add-btn {
    appearance: none;
    border: none;
    background: var(--orbit-ink);
    color: #fffaf3;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.78rem 1.35rem;
    border-radius: 999px;
    cursor: pointer;
    transition: transform 0.25s ease, background-color 0.25s ease;
}

.flavor-add-btn:hover {
    background: var(--orbit-accent);
    transform: translateY(-2px);
}

.flavor-orbit-footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid var(--orbit-ring);
}

.flavor-hint-text {
    margin: 0;
    font-size: 0.85rem;
    color: var(--orbit-muted);
    letter-spacing: 0.02em;
}

.flavor-nav-cluster {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.flavor-step-counter {
    font-size: 0.85rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--orbit-ink);
    margin-right: 0.35rem;
}

.flavor-arrow-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--orbit-ring);
    background: rgba(255, 255, 255, 0.7);
    color: var(--orbit-ink);
    font-size: 1.2rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.2s ease;
}

.flavor-arrow-btn:hover {
    background: var(--orbit-ink);
    color: #fffaf3;
    transform: scale(1.06);
}

.flavor-full-menu-link {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--orbit-ink);
    text-decoration: none;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--orbit-ring);
    transition: background-color 0.25s ease, color 0.25s ease;
}

.flavor-full-menu-link:hover {
    background: var(--orbit-ink);
    color: #fffaf3;
}

/* RIGHT COLUMN: CIRCULAR ORBIT TRACK + ROTATING CUP STACK */
.flavor-orbit-stage {
    position: relative;
    width: var(--orbit-size);
    height: var(--orbit-size);
    margin: 0 auto;
    display: grid;
    place-items: center;
    user-select: none;
}

.flavor-orbit-glow {
    position: absolute;
    width: 68%;
    height: 68%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--orbit-accent) 34%, transparent) 0%, transparent 72%);
    filter: blur(18px);
    transition: background 0.6s ease;
    pointer-events: none;
}

.flavor-orbit-ring {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    border: 1.5px dashed color-mix(in srgb, var(--orbit-ink) 22%, transparent);
    pointer-events: none;
}

.flavor-orbit-ring::after {
    content: "";
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--orbit-ink) 10%, transparent);
}

.flavor-orbit-wheel {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transform: rotate(var(--wheel-rotation, 0deg));
    transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
}

.flavor-orbit-node {
    position: absolute;
    top: 50%;
    left: 50%;
    --node-radius: calc(var(--orbit-size) * 0.44);
    transform:
        translate(-50%, -50%)
        rotate(var(--node-angle))
        translateY(calc(-1 * var(--node-radius)))
        rotate(calc(-1 * var(--node-angle) - var(--wheel-rotation, 0deg)));
    transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1),
                background-color 0.3s ease,
                color 0.3s ease,
                border-color 0.3s ease,
                box-shadow 0.3s ease;
    appearance: none;
    border: 1px solid var(--orbit-ring);
    background: rgba(255, 252, 247, 0.92);
    backdrop-filter: blur(8px);
    color: var(--orbit-ink);
    padding: 0.52rem 1rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: capitalize;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(31, 20, 13, 0.08);
    z-index: 4;
}

.flavor-orbit-node::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--node-color, var(--orbit-accent));
    margin-right: 0.48rem;
    vertical-align: middle;
}

.flavor-orbit-node:hover {
    border-color: var(--orbit-ink);
}

.flavor-orbit-node.is-active {
    background: color-mix(in srgb, var(--orbit-accent) 30%, #fffaf3);
    color: var(--orbit-ink);
    border-color: color-mix(in srgb, var(--orbit-accent) 62%, var(--orbit-ink));
    box-shadow: 0 12px 28px color-mix(in srgb, var(--orbit-accent) 22%, transparent);
}

/* FOCAL POINTER AT TOP OF THE INNER ORBIT (NEAR THE CUP) */
/* CENTER CUP VISUAL STACK (TIRATI OVERHEAD/HERO ROTATION) */
.flavor-cup-stack {
    position: relative;
    width: 88%;
    height: 88%;
    display: grid;
    place-items: center;
    z-index: 2;
}

.flavor-cup-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transform: scale(0.76) rotate(-26deg);
    filter: drop-shadow(0 24px 34px rgba(31, 20, 13, 0.2));
    transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
}

.flavor-cup-slide.is-active {
    opacity: 1;
    transform: scale(1) rotate(0deg);
}

.flavor-cup-slide.is-prev {
    opacity: 0;
    transform: scale(0.8) rotate(24deg);
}

@media (max-width: 991.98px) {
    .flavor-orbit-section {
        height: 320vh;
        --orbit-size: min(88vw, 480px);
    }

    .flavor-orbit-sticky {
        justify-content: flex-start;
        padding-top: 5.25rem;
    }

    .flavor-orbit-inner {
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }

    .flavor-orbit-stage {
        order: -1;
    }

    .flavor-ingredient-art {
        top: 29%;
        left: 50%;
        width: min(62vw, 320px);
        height: min(62vw, 320px);
        opacity: 0.38;
    }

    .flavor-copy-stack {
        min-height: 185px;
    }
}

@media (max-width: 767.98px) {
    .flavor-orbit-section {
        height: 300svh;
        min-height: 0;
        --orbit-size: min(80vw, 30svh, 290px);
    }

    .flavor-orbit-sticky {
        height: 100svh;
        min-height: 0;
        justify-content: center;
        padding: calc(68px + env(safe-area-inset-top)) 16px calc(16px + env(safe-area-inset-bottom));
    }

    .flavor-orbit-inner {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: center;
        gap: 1.5rem;
    }

    .flavor-orbit-stage {
        position: relative;
        inset: auto;
        left: auto;
        top: auto;
        transform: none;
        flex: 0 0 auto;
        width: var(--orbit-size);
        height: var(--orbit-size);
        max-width: 100%;
        margin: 0 auto;
    }

    .flavor-orbit-left {
        flex: 0 0 auto;
    }

    .flavor-ingredient-art {
        top: 16%;
        left: 50%;
        width: min(44vw, 180px);
        height: min(44vw, 180px);
        opacity: 0.2;
    }

    .flavor-orbit-left {
        width: 100%;
        max-width: 520px;
        margin: 0 auto;
        gap: 0.6rem;
    }

    .flavor-copy-stack {
        display: block;
        min-height: clamp(130px, 16svh, 150px);
    }

    .flavor-copy-item {
        inset: auto;
    }

    .flavor-copy-item:not(.is-active) {
        display: none;
    }

    .flavor-copy-item.is-active {
        position: relative;
    }

    .flavor-meta-row {
        gap: 0.45rem;
        margin-bottom: 0.4rem;
    }

    .flavor-meta-category {
        font-size: 0.68rem;
    }

    .flavor-meta-badge {
        padding: 0.18rem 0.55rem;
        font-size: 0.61rem;
    }

    .flavor-item-title {
        font-size: clamp(1.35rem, 5vw, 1.75rem);
        margin-bottom: 0.35rem;
    }

    .flavor-item-desc {
        font-size: 0.82rem;
        line-height: 1.4;
        margin-bottom: 0;
    }

    .flavor-orbit-footer-bar {
        display: grid;
        gap: 0.4rem;
        padding-top: 0.55rem;
    }

    .flavor-hint-text {
        font-size: 0.72rem;
    }

    .flavor-nav-cluster {
        width: 100%;
        gap: 0.35rem;
    }

    .flavor-step-counter {
        font-size: 0.75rem;
        margin-right: 0.1rem;
    }

    .flavor-arrow-btn {
        width: 34px;
        height: 34px;
    }

    .flavor-full-menu-link {
        margin-left: auto;
        padding: 0.45rem 0.65rem;
        font-size: 0.68rem;
        letter-spacing: 0.06em;
    }

    .flavor-orbit-node {
        padding: 0.38rem 0.58rem;
        font-size: 0.7rem;
        --node-radius: calc(var(--orbit-size) * 0.37);
    }
}

@media (prefers-reduced-motion: reduce) {
    .flavor-orbit-section {
        height: auto;
    }

    .flavor-orbit-sticky {
        position: relative;
        height: auto;
    }

    .flavor-orbit-wheel,
    .flavor-orbit-node,
    .flavor-cup-slide,
    .flavor-copy-item,
    .flavor-ingredient-art,
    .flavor-ingredient-image {
        transition: none;
    }
    .flavor-ingredient-image { animation: none; }
}
</style>

<!-- ===================================================== -->
<!-- LOADING SCREEN -->
<!-- ===================================================== -->

<div id="coffeeLoader" role="status" aria-live="polite" aria-label="Loading every cup">

    <div class="loader-background">

        <div class="loader-content">

            <!-- BEANS DRIFTING BEHIND THE CUP (drawn in SVG, no images) -->
            <div class="loader-bean-rain" aria-hidden="true">
                {% for i in 1..10 %}
                    <svg class="rain-bean" viewBox="-13 -18 26 36"
                         style="left: {{ (i * 37) % 90 + 3 }}%; width: {{ 16 + (i * 7) % 14 }}px; animation-duration: {{ 3.2 + (i % 4) * 0.5 }}s; animation-delay: {{ (0.3 + i * 0.28)|round(2) }}s;">
                        <use href="#lcBeanShape"/>
                    </svg>
                {% endfor %}
            </div>

            <!-- LOGO: pops in, then shrinks into the bean -->
            <div class="loader-logo-container">
                <img src="{{ asset('images/logo.png') }}" class="loader-logo" alt="Every Cup Logo">
            </div>

            <!-- COFFEE CUP SCENE: rises, lid pops open, bean drops into the coffee -->
            <svg class="loader-scene" viewBox="0 -70 300 440" aria-hidden="true">
                <defs>
                    <linearGradient id="lcBody" x1="0" x2="1" y1="0" y2="0">
                        <stop offset="0" stop-color="#cfc8bb"/><stop offset=".22" stop-color="#fffdf8"/>
                        <stop offset=".5" stop-color="#f7f2e8"/><stop offset=".82" stop-color="#d8d0c2"/><stop offset="1" stop-color="#b9b0a0"/>
                    </linearGradient>
                    <linearGradient id="lcShade" x1="0" x2="1" y1="0" y2="0">
                        <stop offset="0" stop-color="#000" stop-opacity=".3"/><stop offset=".16" stop-color="#fff" stop-opacity="0"/>
                        <stop offset=".27" stop-color="#fff" stop-opacity=".42"/><stop offset=".38" stop-color="#fff" stop-opacity="0"/>
                        <stop offset=".76" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".36"/>
                    </linearGradient>
                    <linearGradient id="lcSleeve" x1="0" x2="1" y1="0" y2="0">
                        <stop offset="0" stop-color="#7d532d"/><stop offset=".28" stop-color="#b88454"/>
                        <stop offset=".46" stop-color="#c99666"/><stop offset=".78" stop-color="#9e6c3f"/><stop offset="1" stop-color="#6e4623"/>
                    </linearGradient>
                    <linearGradient id="lcWall" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0" stop-color="#a39886"/><stop offset="1" stop-color="#e6dfd0"/>
                    </linearGradient>
                    <linearGradient id="lcLid" x1="0" x2="1" y1="0" y2="0">
                        <stop offset="0" stop-color="#14100d"/><stop offset=".3" stop-color="#3b342f"/>
                        <stop offset=".6" stop-color="#25201c"/><stop offset="1" stop-color="#0f0c0a"/>
                    </linearGradient>
                    <radialGradient id="lcLidTop" cx=".4" cy=".35" r=".75">
                        <stop offset="0" stop-color="#4d453e"/><stop offset="1" stop-color="#221d19"/>
                    </radialGradient>
                    <radialGradient id="lcCoffee" cx=".42" cy=".4" r=".7">
                        <stop offset="0" stop-color="#7d4726"/><stop offset=".6" stop-color="#4a2410"/><stop offset="1" stop-color="#25110a"/>
                    </radialGradient>
                    <radialGradient id="lcBean" cx=".35" cy=".3" r=".85">
                        <stop offset="0" stop-color="#8d5834"/><stop offset=".55" stop-color="#4d2810"/><stop offset="1" stop-color="#1f0f08"/>
                    </radialGradient>
                    <filter id="lcBlur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3"/></filter>
                    <filter id="lcShadowBlur" x="-30%" y="-100%" width="160%" height="300%"><feGaussianBlur stdDeviation="6"/></filter>
                    <clipPath id="lcMouth"><ellipse cx="150" cy="150" rx="76" ry="13.5"/></clipPath>
                    <clipPath id="lcAbove"><rect x="-60" y="-120" width="420" height="278"/></clipPath>
                    <g id="lcBeanShape">
                        <ellipse rx="10.5" ry="15.5" fill="url(#lcBean)"/>
                        <path d="M-1.5,-14 C5,-5 -6,4 1.5,14" fill="none" stroke="#150a05" stroke-width="2" stroke-linecap="round"/>
                        <ellipse cx="-4" cy="-6" rx="2.5" ry="5" fill="#fff" opacity=".2" transform="rotate(14 -4 -6)"/>
                    </g>
                    <path id="lcDrop" d="M0,-4 C2.6,-1 3,1.5 0,3.2 C-3,1.5 -2.6,-1 0,-4 Z"/>
                </defs>

                <ellipse class="lc-shadow" cx="150" cy="327" rx="86" ry="11" fill="#3a2410" filter="url(#lcShadowBlur)"/>

                <g class="lc-rig">
                    <!-- cup body, kraft sleeve, brand, cylinder shading -->
                    <path d="M72,150 A78,15 0 0 0 228,150 L202,316 A52,10 0 0 1 98,316 Z" fill="url(#lcBody)"/>
                    <path d="M80.5,205 Q150,219 219.5,205 L209.7,268 Q150,282 90.3,268 Z" fill="url(#lcSleeve)"/>
                    <text class="lc-brand" x="150" y="238" text-anchor="middle">every</text>
                    <text class="lc-brand lc-brand-b" x="150" y="260" text-anchor="middle">cup.</text>
                    <path d="M72,150 A78,15 0 0 0 228,150 L202,316 A52,10 0 0 1 98,316 Z" fill="url(#lcShade)"/>

                    <!-- open mouth: inner wall, coffee surface, ripples -->
                    <ellipse cx="150" cy="150" rx="78" ry="15" fill="url(#lcWall)"/>
                    <g clip-path="url(#lcMouth)">
                        <g class="lc-surface">
                            <ellipse cx="150" cy="163" rx="78" ry="14.5" fill="url(#lcCoffee)"/>
                            <ellipse class="lc-crema" cx="150" cy="163" rx="58" ry="9.5" fill="none" stroke="#c99a68" stroke-width="3" stroke-dasharray="26 18 8 22"/>
                            <ellipse cx="122" cy="155" rx="22" ry="2.6" fill="#fff" opacity=".13"/>
