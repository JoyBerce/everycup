<!-- FEATURED MENU -->
<!-- ===================================================== -->

<section class="menu-section section-padding" id="menu">

    <div class="container-xxl px-4">

        <div class="menu-heading reveal">

            <div>

                <div class="section-eyebrow">
                    A CUP FOR EVERY MOOD
                </div>

                <h2 class="section-title">
                    Find your <span>favorite.</span>
                </h2>

                <p class="section-description">
                    Discover drinks that make your everyday
                    moments a little more special.
                </p>

            </div>

            <div class="menu-heading-stamp">
                EVERY CUP.
                <span>EVERY MOMENT.</span>
            </div>

        </div>


        <div class="row g-4 menu-card-container">

            {% for product in featuredProducts %}

                <div class="col-md-6 col-lg-4">

                    <div class="menu-card reveal">

                        <div class="menu-card-image">

                            <span class="menu-category">
                                {{ product.category }}
                            </span>

                            <img src="{{ asset(product.image) }}"
                                 alt="{{ product.name }}"
                                 loading="lazy">

                        </div>

                        <div class="menu-card-content">

                            <div class="d-flex justify-content-between align-items-center">

                                <h3>{{ product.name }}</h3>

                                <span class="menu-price">
                                    {{ product.price }}
                                </span>

                            </div>

                            <p>
