                    .set(d, { visible: true })
                    .set(d.position, { x: 0, y: TOP + 0.02 })
                    .to(d.position, { x: dx * 1.1, duration: 0.64, ease: 'none' }, 0)
                    .to(d.position, { y: TOP + 0.02 + h, duration: 0.31, ease: 'power2.out' }, 0)
                    .to(d.position, { y: TOP + 0.02, duration: 0.33, ease: 'power2.in' }, 0.31)
                    .set(d, { visible: false }, 0.62),
                0.65 + i * 0.12);
