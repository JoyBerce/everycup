<section class="menu-section flavor-orbit-section" id="menu" aria-label="Take a closer look at featured flavors">
    {% set orbitFlavors = [
        {
            name: 'Mango Cream',
            short: 'Mango',
            category: 'Non-coffee drink',
            badge: 'Best Seller',
            lead: 'Real mango, mellow cream.',
            description: 'Sun-ripened mango brings a bright, tangy first sip, softened by a cool ribbon of cream. It tastes like ripe fruit and dessert meeting in the same cup.',
            image: 'images/home/1 (1).png',
            art: 'images/home/mango.png',
            price: '145',
            color: '#d2a900',
            bg: '#fbf4d9'
        },
        {
            name: 'Matcha Cloud',
            short: 'Matcha',
            category: 'Non-coffee drink',
            badge: 'Signature Drink',
            lead: 'Earthy matcha, cloud-soft cream.',
            description: 'A gentle grassy note from matcha opens into cold, fresh milk, finished with a soft cap of cream. Smooth, lightly sweet, and made for a slower sip.',
            image: 'images/home/1 (2).png',
            art: 'images/home/matcha_leaf.png',
            price: '145',
            color: '#536b45',
            bg: '#eef3ea'
        },
        {
            name: 'Strawberry Milk',
            short: 'Strawberry',
            category: 'Non-coffee drink',
            badge: 'Best Seller',
            lead: 'Strawberries with a creamy finish.',
            description: 'Juicy strawberry flavor runs through chilled milk for a sweet, fresh fruit note that stays silky to the last sip.',
            image: 'images/home/1 (3).png',
            art: 'images/home/strawberry.png',
            price: '140',
            color: '#b84c4b',
            bg: '#f8ecec'
        },
        {
            name: 'Tiramisu Latte',
            short: 'Tiramisu',
            category: 'Espresso drink',
            badge: 'Best Seller',
            lead: 'Espresso meets tiramisu.',
            description: 'Bold espresso and velvety mascarpone-style cream bring the familiar coffee-and-cocoa comfort of tiramisu to an iced latte.',
            image: 'images/home/1 (4).png',
            art: 'images/home/chocolate.png',
            price: '155',
            color: '#6b4234',
            bg: '#f4ece6'
        }
    ] %}

    <div class="flavor-orbit-sticky">
        <div class="flavor-ingredient-art" aria-hidden="true">
            {% for flavor in orbitFlavors %}
                <img class="flavor-ingredient-image{% if loop.first %} is-active{% endif %}"
                     src="{{ asset(flavor.art) }}" alt="" draggable="false"
                     data-ingredient-image="{{ loop.index0 }}">
            {% endfor %}
        </div>
        <div class="flavor-orbit-inner" role="group" aria-label="Four signature drinks in orbit">

            <!-- LEFT: EDITORIAL HEADING + STACKED FLAVOR DETAILS -->
            <div class="flavor-orbit-left">

                <div class="flavor-copy-stack">
                    {% for flavor in orbitFlavors %}
                        <div class="flavor-copy-item{% if loop.first %} is-active{% endif %}" data-flavor-copy="{{ loop.index0 }}" aria-hidden="{{ loop.first ? 'false' : 'true' }}">
                            <div class="flavor-meta-row">
                                <p class="flavor-meta-category">{{ flavor.category }}</p>
                                <span class="flavor-meta-dot" aria-hidden="true"></span>
                                <span class="flavor-meta-badge">{{ flavor.badge }}</span>
                            </div>
                            <h3 class="flavor-item-title">{{ flavor.name }}</h3>
                            <p class="flavor-item-desc"><strong>{{ flavor.lead }}</strong> {{ flavor.description }}</p>
                        </div>
                    {% endfor %}
                </div>

                <div class="flavor-orbit-footer-bar">
                    <div class="flavor-nav-cluster">
                        <a href="{{ path('app_menu') }}" class="flavor-full-menu-link">See every drink ↗</a>
                    </div>
                </div>
            </div>

            <!-- RIGHT: ORBITAL RING + ROTATING CUP SHOWCASE -->
            <div class="flavor-orbit-stage" data-flavor-orbit>
                <div class="flavor-orbit-glow" aria-hidden="true"></div>
                <div class="flavor-orbit-ring" aria-hidden="true"></div>
                <div class="flavor-orbit-wheel" data-orbit-wheel>
                    {% for flavor in orbitFlavors %}
                        {% set angle = loop.index0 * (360 / orbitFlavors|length) %}
                        <button type="button"
                                class="flavor-orbit-node{% if loop.first %} is-active{% endif %}"
                                data-flavor-index="{{ loop.index0 }}"
                                style="--node-angle: {{ angle }}deg; --node-color: {{ flavor.color }};"
                                aria-pressed="{{ loop.first ? 'true' : 'false' }}">
                            {{ flavor.short }}
                        </button>
                    {% endfor %}
                </div>

                <div class="flavor-cup-stack">
                    {% for flavor in orbitFlavors %}
                        <img class="flavor-cup-slide{% if loop.first %} is-active{% endif %}"
                             src="{{ asset(flavor.image) }}"
                             alt="{{ flavor.name }}"
                             draggable="false"
                             data-flavor-slide="{{ loop.index0 }}">
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>

    <script type="application/json" data-orbit-flavors>{{ orbitFlavors|json_encode|raw }}</script>
</section>

