{% extends 'base.html.twig' %}

{% block title %}
    every cup. | Your Cup, Your Story
{% endblock %}

{% block body %}



<!-- ===================================================== -->
<!-- LOADING SCREEN -->
<!-- ===================================================== -->

<div id="coffeeLoader" role="status" aria-live="polite" aria-label="Loading every cup">

    <div class="loader-background">

        <div class="loader-content">

            <!-- BEANS DRIFTING BEHIND THE CUP (drawn in SVG, no images) -->
            <div class="loader-bean-rain" aria-hidden="true">
                {% for i in 1..10 %}
                    <svg class="rain-bean" viewBox="-13 -18 26 36"
                         style="left: {{ (i * 37) % 90 + 3 }}%; width: {{ 16 + (i * 7) % 14 }}px; animation-duration: {{ 3.2 + (i % 4) * 0.5 }}s; animation-delay: {{ (0.3 + i * 0.28)|round(2) }}s;">
                        <use href="#lcBeanShape"/>
                    </svg>
                {% endfor %}
            </div>

            <!-- LOGO: pops in, then shrinks into the bean -->
            <div class="loader-logo-container">
                <img src="{{ asset('images/logo.png') }}" class="loader-logo" alt="Every Cup Logo">
            </div>

            <!-- COFFEE CUP SCENE: rises, lid pops open, bean drops into the coffee -->
            <svg class="loader-scene" viewBox="0 -70 300 440" aria-hidden="true">
                <defs>
                    <linearGradient id="lcBody" x1="0" x2="1" y1="0" y2="0">
                        <stop offset="0" stop-color="#cfc8bb"/><stop offset=".22" stop-color="#fffdf8"/>
                        <stop offset=".5" stop-color="#f7f2e8"/><stop offset=".82" stop-color="#d8d0c2"/><stop offset="1" stop-color="#b9b0a0"/>
                    </linearGradient>
                    <linearGradient id="lcShade" x1="0" x2="1" y1="0" y2="0">
                        <stop offset="0" stop-color="#000" stop-opacity=".3"/><stop offset=".16" stop-color="#fff" stop-opacity="0"/>
                        <stop offset=".27" stop-color="#fff" stop-opacity=".42"/><stop offset=".38" stop-color="#fff" stop-opacity="0"/>
                        <stop offset=".76" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".36"/>
                    </linearGradient>
                    <linearGradient id="lcSleeve" x1="0" x2="1" y1="0" y2="0">
                        <stop offset="0" stop-color="#7d532d"/><stop offset=".28" stop-color="#b88454"/>
                        <stop offset=".46" stop-color="#c99666"/><stop offset=".78" stop-color="#9e6c3f"/><stop offset="1" stop-color="#6e4623"/>
                    </linearGradient>
                    <linearGradient id="lcWall" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0" stop-color="#a39886"/><stop offset="1" stop-color="#e6dfd0"/>
                    </linearGradient>
                    <linearGradient id="lcLid" x1="0" x2="1" y1="0" y2="0">
                        <stop offset="0" stop-color="#14100d"/><stop offset=".3" stop-color="#3b342f"/>
                        <stop offset=".6" stop-color="#25201c"/><stop offset="1" stop-color="#0f0c0a"/>
                    </linearGradient>
                    <radialGradient id="lcLidTop" cx=".4" cy=".35" r=".75">
                        <stop offset="0" stop-color="#4d453e"/><stop offset="1" stop-color="#221d19"/>
                    </radialGradient>
                    <radialGradient id="lcCoffee" cx=".42" cy=".4" r=".7">
                        <stop offset="0" stop-color="#7d4726"/><stop offset=".6" stop-color="#4a2410"/><stop offset="1" stop-color="#25110a"/>
                    </radialGradient>
                    <radialGradient id="lcBean" cx=".35" cy=".3" r=".85">
                        <stop offset="0" stop-color="#8d5834"/><stop offset=".55" stop-color="#4d2810"/><stop offset="1" stop-color="#1f0f08"/>
                    </radialGradient>
                    <filter id="lcBlur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3"/></filter>
                    <filter id="lcShadowBlur" x="-30%" y="-100%" width="160%" height="300%"><feGaussianBlur stdDeviation="6"/></filter>
                    <clipPath id="lcMouth"><ellipse cx="150" cy="150" rx="76" ry="13.5"/></clipPath>
                    <clipPath id="lcAbove"><rect x="-60" y="-120" width="420" height="278"/></clipPath>
                    <g id="lcBeanShape">
                        <ellipse rx="10.5" ry="15.5" fill="url(#lcBean)"/>
                        <path d="M-1.5,-14 C5,-5 -6,4 1.5,14" fill="none" stroke="#150a05" stroke-width="2" stroke-linecap="round"/>
                        <ellipse cx="-4" cy="-6" rx="2.5" ry="5" fill="#fff" opacity=".2" transform="rotate(14 -4 -6)"/>
                    </g>
                    <path id="lcDrop" d="M0,-4 C2.6,-1 3,1.5 0,3.2 C-3,1.5 -2.6,-1 0,-4 Z"/>
                </defs>

                <ellipse class="lc-shadow" cx="150" cy="327" rx="86" ry="11" fill="#3a2410" filter="url(#lcShadowBlur)"/>

                <g class="lc-rig">
                    <!-- cup body, kraft sleeve, brand, cylinder shading -->
                    <path d="M72,150 A78,15 0 0 0 228,150 L202,316 A52,10 0 0 1 98,316 Z" fill="url(#lcBody)"/>
                    <path d="M80.5,205 Q150,219 219.5,205 L209.7,268 Q150,282 90.3,268 Z" fill="url(#lcSleeve)"/>
                    <text class="lc-brand" x="150" y="238" text-anchor="middle">every</text>
                    <text class="lc-brand lc-brand-b" x="150" y="260" text-anchor="middle">cup.</text>
                    <path d="M72,150 A78,15 0 0 0 228,150 L202,316 A52,10 0 0 1 98,316 Z" fill="url(#lcShade)"/>

                    <!-- open mouth: inner wall, coffee surface, ripples -->
                    <ellipse cx="150" cy="150" rx="78" ry="15" fill="url(#lcWall)"/>
                    <g clip-path="url(#lcMouth)">
                        <g class="lc-surface">
                            <ellipse cx="150" cy="163" rx="78" ry="14.5" fill="url(#lcCoffee)"/>
                            <ellipse class="lc-crema" cx="150" cy="163" rx="58" ry="9.5" fill="none" stroke="#c99a68" stroke-width="3" stroke-dasharray="26 18 8 22"/>
                            <ellipse cx="122" cy="155" rx="22" ry="2.6" fill="#fff" opacity=".13"/>
                            <ellipse class="lc-ripple r1" cx="150" cy="157" rx="30" ry="5.3" fill="none" stroke="#e8c99a" stroke-width="1.6"/>
                            <ellipse class="lc-ripple r2" cx="150" cy="157" rx="30" ry="5.3" fill="none" stroke="#e8c99a" stroke-width="1.3"/>
                            <ellipse class="lc-ripple r3" cx="150" cy="157" rx="30" ry="5.3" fill="none" stroke="#e8c99a" stroke-width="1"/>
                        </g>
                    </g>
                    <ellipse cx="150" cy="150" rx="78" ry="15" fill="none" stroke="#fff" stroke-width="3.2"/>
                    <ellipse cx="150" cy="151.6" rx="78" ry="15" fill="none" stroke="#bdb4a4" stroke-width=".8" opacity=".8"/>

                    <!-- splash droplets (leave the surface on impact, fall back with gravity) -->
                    <g class="lc-splash" transform="translate(150 156)" fill="#7b4524" stroke="#d8a36a" stroke-width=".4">
                        <g class="dx" style="--dx:-30px;--h:-30px;--dl:0s;--dur:.8s"><g class="dy"><use href="#lcDrop" transform="scale(1.3)"/></g></g>
                        <g class="dx" style="--dx:-17px;--h:-46px;--dl:.03s;--dur:.95s"><g class="dy"><use href="#lcDrop" transform="scale(1.5)"/></g></g>
                        <g class="dx" style="--dx:-6px;--h:-54px;--dl:0s;--dur:1s"><g class="dy"><use href="#lcDrop" transform="scale(1.7)"/></g></g>
                        <g class="dx" style="--dx:8px;--h:-50px;--dl:.05s;--dur:.98s"><g class="dy"><use href="#lcDrop" transform="scale(1.4)"/></g></g>
                        <g class="dx" style="--dx:20px;--h:-40px;--dl:.02s;--dur:.9s"><g class="dy"><use href="#lcDrop" transform="scale(1.3)"/></g></g>
                        <g class="dx" style="--dx:33px;--h:-26px;--dl:.06s;--dur:.78s"><g class="dy"><use href="#lcDrop" transform="scale(1.2)"/></g></g>
                        <g class="dx" style="--dx:-24px;--h:-18px;--dl:.1s;--dur:.6s"><g class="dy"><use href="#lcDrop" transform="scale(1)"/></g></g>
                    </g>

                    <!-- lid: pops, tilts and slides off -->
                    <g class="lc-lid">
                        <path d="M68,140 L68,149 A82,16 0 0 0 232,149 L232,140 Z" fill="url(#lcLid)"/>
                        <ellipse cx="150" cy="140" rx="82" ry="16" fill="url(#lcLidTop)"/>
                        <ellipse cx="150" cy="140" rx="74" ry="13.5" fill="none" stroke="#000" stroke-opacity=".35" stroke-width="1.4"/>
                        <path d="M92,133 L92,140 A58,11 0 0 0 208,140 L208,133 Z" fill="url(#lcLid)"/>
                        <ellipse cx="150" cy="133" rx="58" ry="11" fill="url(#lcLidTop)"/>
                        <ellipse cx="186" cy="131.5" rx="12" ry="3.4" fill="#0b0806"/>
                        <path d="M175,131 Q186,127.6 197,131" fill="none" stroke="#fff" stroke-opacity=".22" stroke-width="1"/>
                        <path d="M96,128 Q150,118 204,128" fill="none" stroke="#fff" stroke-opacity=".16" stroke-width="2" stroke-linecap="round"/>
                    </g>

                    <!-- steam leaves the cup once the lid is off -->
                    <g class="lc-steam" filter="url(#lcBlur)" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round">
                        <path class="s1" d="M128,136 C118,116 138,100 126,78 C118,62 132,50 126,34"/>
                        <path class="s2" d="M152,136 C142,113 163,98 150,72 C142,54 158,42 150,24"/>
                        <path class="s3" d="M176,136 C168,117 186,102 176,80 C170,64 182,54 176,40"/>
                    </g>
                </g>

                <!-- the bean: hidden below the coffee surface by the clip -->
                <g clip-path="url(#lcAbove)">
                    <g transform="translate(150 -25)"><g class="lc-bean"><use href="#lcBeanShape"/></g></g>
                </g>
            </svg>

            <p class="loader-caption">EVERY MOMENT STARTS WITH A CUP.</p>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- HERO SECTION -->
<!-- ===================================================== -->

<section class="hero-section" id="home">

    <div class="hero-background-decoration"></div>

    <!-- FALLING COFFEE BEANS -->
    <div class="hero-beans" aria-hidden="true">
        {% for i in 1..16 %}
            <span class="bean-particle">
                <img src="{{ asset('images/home/coffee-bean.png') }}" alt="">
            </span>
        {% endfor %}
    </div>

    <div class="container-fluid container-xxl">

        <div class="row align-items-center hero-row">

            <!-- LEFT CONTENT (MORPHS ON CUP HOVER) -->
            <div class="col-lg-6 hero-text-column">

                <div class="hero-copy-wrapper">

                    <!-- STATE 1: DEFAULT COPY -->
                    <div class="hero-copy-state hero-copy-default">
                        <div class="hero-eyebrow reveal">
                            <span class="eyebrow-line"></span>
                            <span>SAMPALOC, MANILA Â· YOUR DAILY COFFEE SPOT</span>
                        </div>

                        <h1 class="hero-title reveal">
                            Every cup.
                            <br>
                            has a <span>story.</span>
                        </h1>

                        <p class="hero-description reveal">
                            From your first sip to your favorite daily ritual,
                            every cup is made to bring a little happiness
                            to your everyday moments.
                        </p>

                        <div class="hero-buttons reveal">
                            <a href="#menu" class="btn-primary-custom">
                                FIND YOUR CUP
                                <span>â†—</span>
                            </a>

                            <a href="#experience" class="btn-outline-custom">
                                EXPLORE OUR STORY
                            </a>
                        </div>
                    </div>

                    <!-- STATE 2: HOVERED BREW COPY (MATCHING VIDEO) -->
                    <div class="hero-copy-state hero-copy-hovered" aria-hidden="true">
                        <div class="hero-eyebrow">
                            <span class="eyebrow-line"></span>
                            <span>THE EVERY CUP WAY</span>
                        </div>

                        <h2 class="hero-title">
                            a better kind
                            <br>
                            of <span>brew.</span>
                        </h2>

                        <p class="hero-description">
                            A simple glass of fresh, creamy milk to make the day a little better.
                        </p>

                        <div class="hero-buttons">
                            <a href="#menu" class="btn-primary-custom">
                                EXPLORE THE MENU
                                <span>â†’</span>
                            </a>

                            <a href="#visit" class="btn-outline-custom">
                                PRE-ORDER A CUP
                            </a>
                        </div>
                    </div>

                </div>

                <div class="hero-bottom-note reveal">
                    <span class="hero-note-dot"></span>
                    FRESHLY MADE. ALWAYS MADE WITH LOVE.
                </div>

            </div>


            <!-- RIGHT HERO VISUAL -->
            <div class="col-lg-6 hero-visual-column">

                <div class="hero-visual reveal">

                    <!-- YELLOW LOGO BEHIND THE CUPS -->
                    <div class="hero-logo-background">
                        <img src="{{ asset('images/logo.png') }}" alt="Every Cup Logo">
                    </div>

                    <!-- INTERACTIVE HERO CUP: HOVER TO POUR CHOCOLATE -->
                    <div class="hero-cup-stage" id="heroCupStage" aria-label="A clear glass filled with fresh milk">

                        <!-- Shared filter for the chocolate swirl -->
                        <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
                            <filter id="chocoSwirl" x="-10%" y="-10%" width="120%" height="120%">
                                <feTurbulence type="fractalNoise" baseFrequency="0.012 0.03" numOctaves="2" seed="7" result="noise">
                                    <animate attributeName="baseFrequency" dur="10s" values="0.012 0.03;0.02 0.02;0.012 0.03" repeatCount="indefinite"/>
                                </feTurbulence>
                                <feDisplacementMap in="SourceGraphic" in2="noise" scale="22" xChannelSelector="R" yChannelSelector="G"/>
                            </filter>
                        </svg>
                        <div class="espresso-pour-wrapper" aria-hidden="true">
                            <svg class="espresso-stream-svg" viewBox="0 0 120 380" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="chocoGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                        <stop offset="0%" stop-color="#1b0b05"/><stop offset="35%" stop-color="#4a2412"/>
                                        <stop offset="62%" stop-color="#7a4426"/><stop offset="100%" stop-color="#1f0d06"/>
                                    </linearGradient>
                                    <linearGradient id="chocoShine" x1="0%" y1="0%" x2="0%" y2="100%">
                                        <stop offset="0%" stop-color="rgba(255,225,190,0.5)"/><stop offset="100%" stop-color="rgba(255,225,190,0.12)"/>
                                    </linearGradient>
                                </defs>
                                <path class="stream-core" d="M46,0 C47,90 46,190 49,290 Q50.5,345 52.5,380 L67.5,380 Q69.5,345 71,290 C74,190 73,90 74,0 Z" fill="url(#chocoGrad)"/>
                                <path class="stream-shine" d="M52,0 C53,90 52,190 54,290 Q55,340 56,380 L59,380 Q58,340 59,290 C58,190 58.5,90 58,0 Z" fill="url(#chocoShine)"/>
                            </svg>
                        </div>

                        <!-- LEFT BACKGROUND BROWN KRAFT CUP -->
                        <div class="bg-kraft-cup kraft-left" aria-hidden="true">
                            <div class="kraft-lid">
                                <div class="kraft-lid-top"></div>
                                <div class="kraft-lid-rim"></div>
                            </div>
                            <div class="kraft-body">
                                <div class="kraft-sleeve">
                                    <span class="kraft-brand">every<br><strong>cup</strong></span>
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT BACKGROUND BROWN KRAFT CUP -->
                        <div class="bg-kraft-cup kraft-right" aria-hidden="true">
                            <div class="kraft-lid">
                                <div class="kraft-lid-top"></div>
                                <div class="kraft-lid-rim"></div>
                            </div>
                            <div class="kraft-body">
                                <div class="kraft-sleeve">
                                    <span class="kraft-brand">every<br><strong>cup</strong></span>
                                </div>
                            </div>
                        </div>

                        <!-- MAIN CENTER REALISTIC ICED LATTE CUP -->
                        <div class="main-iced-cup">
                            <!-- Top Rim & Opening -->
                            <div class="cup-top-rim"></div>

                            <!-- Cup Glass/PET Body -->
                            <div class="cup-plastic-body">

                                <!-- Base Cold Fresh Milk Layer -->
                                <div class="milk-base-layer"></div>

                                <!-- Chocolate pour and milk-to-chocolate hover effect -->
                                <div class="choco-mix" aria-hidden="true">
                                    <div class="choco-flow">
                                        <div class="choco-tint"></div>
                                        <div class="choco-plume plume-1"></div><div class="choco-plume plume-2"></div>
                                        <div class="choco-plume plume-3"></div><div class="choco-plume plume-4"></div>
                                    </div>
                                    <div class="choco-pool"></div>
                                </div>
                                <div class="ice-cubes-cluster" aria-hidden="true">
                                    <div class="ice-cube cube-1"></div><div class="ice-cube cube-2"></div>
                                    <div class="ice-cube cube-3"></div><div class="ice-cube cube-4"></div>
                                </div>
                                <div class="choco-mound"></div>
                                <div class="choco-ripple"></div><div class="choco-ripple r2"></div>
                                <div class="choco-drop cd-1"></div><div class="choco-drop cd-2"></div>
                                <div class="choco-drop cd-3"></div><div class="choco-drop cd-4"></div><div class="choco-drop cd-5"></div>

                                <!-- Printed Cup Logo -->
                                <div class="cup-printed-logo">
                                    <span>every</span>
                                    <strong>cup</strong>
                                </div>

                                <!-- Realistic Plastic Specular Highlights & Condensation -->
                                <div class="cup-glass-highlight-left"></div>
                                <div class="cup-glass-highlight-right"></div>
                            </div>

                            <!-- Thick Clear Cup Base -->
                            <div class="cup-bottom-base"></div>
                        </div>

                        <!-- DRINK BADGE CALLOUT -->
                        <div class="drink-price-badge">
                            <span class="badge-dot"></span>
                            <span>Fresh Milk</span>
                        </div>

                        <!-- SCATTERING 3D COFFEE BEANS (Disperse on Hover) -->
                        <div class="stage-beans-layer" aria-hidden="true">
                            <div class="hero-floating-bean bean-one">
                                <img src="{{ asset('images/home/coffee-bean.png') }}" alt="">
                            </div>
                            <div class="hero-floating-bean bean-two">
                                <img src="{{ asset('images/home/coffee-bean.png') }}" alt="">
                            </div>
                            <div class="hero-floating-bean bean-three">
                                <img src="{{ asset('images/home/coffee-bean.png') }}" alt="">
                            </div>
                            <div class="hero-floating-bean bean-four">
                                <img src="{{ asset('images/home/coffee-bean.png') }}" alt="">
                            </div>
                        </div>

                    </div>

                    <!-- WOODEN SAUCER / COASTER -->
                    <div class="hero-saucer"></div>

                    <!-- SCATTERED ROASTED BEANS ON TABLE -->
                    <div class="table-beans" aria-hidden="true">
                        <span class="t-bean tb-1"></span>
                        <span class="t-bean tb-2"></span>
                        <span class="t-bean tb-3"></span>
                        <span class="t-bean tb-4"></span>
                    </div>

                    <div class="hero-stamp">
                        <span>EVERY</span>
                        <strong>SIP MATTERS.</strong>
                    </div>

                </div>

            </div>


        </div>

    </div>

    <!-- SCROLL INDICATOR -->
    <a href="#menu" class="hero-scroll-indicator">
        <span>SCROLL TO EXPLORE</span>
        <div class="scroll-line"></div>
    </a>

</section>


<!-- ===================================================== -->
