        });

        ripples.forEach(function (r, i) {
            pour.fromTo(r, { opacity: 0.85, scaleX: 0.3, scaleY: 0.3 },
                { opacity: 0, scaleX: 2.6, scaleY: 2.1, duration: 1.05, ease: 'power2.out', repeat: 2 }, 0.65 + i * 0.17);
        });

        drops.forEach(function (d, i) {
            const dx = parseFloat(d.getAttribute('data-dx')), h = parseFloat(d.getAttribute('data-h'));
            pour.add(
                gsap.timeline({ repeat: 3, repeatRefresh: true })
                    .set(d, { x: 0, y: 0, opacity: 1 })
                    .to(d, { x: function () { return dx * (0.8 + Math.random() * 0.4); }, duration: 0.64, ease: 'none' }, 0)
                    .to(d, { y: h, duration: 0.31, ease: 'power2.out' }, 0)
                    .to(d, { y: 2, duration: 0.33, ease: 'power2.in' }, 0.31)
