{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .door-entry-stage {
            position: relative;
            width: 100%;
            height: 80vh;
            min-height: 500px;
            max-height: 760px;
            border-radius: 2rem;
            overflow: hidden;
            perspective: 1200px;
            background: #141210;
            border: 4px solid #141210;
        }

        .door-camera {
            position: relative;
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
            transform-origin: 58% 60%;
            will-change: transform;
        }

        /* Storefront facade & glass grid framing the entrance */
        .facade-wall {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, #f3e7b3 0%, #e7d48c 42%, #9a9488 43%, #78736a 100%);
            transform-style: preserve-3d;
        }

        .facade-sign {
            position: absolute;
            top: 14%;
            left: 50%;
            transform: translateX(-50%) translateZ(24px);
            background: #141210;
            color: #febe10;
            padding: 0.75rem 1.75rem;
            border-radius: 0.85rem;
            border: 3px solid #febe10;
            text-align: center;
            box-shadow: 0 18px 35px rgba(0, 0, 0, 0.45);
        }

        .facade-sign .brand-title {
            font-size: clamp(1.4rem, 3vw, 2.3rem);
            font-weight: 900;
            letter-spacing: -0.03em;
            line-height: 1.05;
        }

        .facade-sign .brand-sub {
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #ffffff;
            margin-top: 0.25rem;
        }

        /* Side window mullions beside the door */
        .side-window {
            position: absolute;
            top: 43%;
            left: 28%;
            width: 21%;
            height: 41%;
            background: linear-gradient(155deg, rgba(255, 255, 255, 0.22), rgba(20, 24, 28, 0.78));
            border: 6px solid #181818;
            box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.65);
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(3, 1fr);
        }

        .side-window span {
            border: 3px solid #181818;
        }

        /* Recessed dark doorway opening (no inside room shown) */
        .doorway-opening {
            position: absolute;
            top: 42%;
            left: 50%;
            width: 17%;
            height: 43%;
            background: radial-gradient(circle at 50% 35%, #26221e 0%, #0b0a09 78%, #050505 100%);
            border: 6px solid #141210;
            box-shadow: inset 0 0 45px rgba(0, 0, 0, 0.95);
            transform-style: preserve-3d;
        }

        /* 3D Swinging Door Panel */
        .door-panel {
            position: relative;
            width: 100%;
            height: 100%;
            transform-origin: right center;
            transform-style: preserve-3d;
            background: linear-gradient(160deg, #2b2927 0%, #161514 55%, #0d0c0c 100%);
            border: 3px solid #3c3834;
            box-shadow: -12px 14px 28px rgba(0, 0, 0, 0.65);
            will-change: transform;
        }

        .door-glass-pane {
            position: absolute;
            top: 10%;
            left: 16%;
            right: 16%;
            height: 54%;
            border-radius: 4px;
            border: 2px solid rgba(255, 255, 255, 0.16);
            background: linear-gradient(125deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0.03) 48%, rgba(0, 0, 0, 0.45) 100%);
        }

        .door-handle {
            position: absolute;
            top: 54%;
            left: 14%;
            width: 10px;
            height: 42px;
            border-radius: 999px;
            background: linear-gradient(180deg, #e5e7eb, #6b7280);
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.6);
        }

        /* Steps leading up to the door */
        .entry-steps {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 16%;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        .entry-step {
            height: 33.33%;
            border-top: 2px solid rgba(255, 255, 255, 0.14);
        }

        .entry-step:nth-child(1) {
            width: 76%;
            margin-left: 24%;
            background: #8c877d;
        }

        .entry-step:nth-child(2) {
            width: 86%;
            margin-left: 14%;
            background: #7b766c;
        }

        .entry-step:nth-child(3) {
            width: 100%;
            background: #69645b;
        }

        .door-caption {
            position: absolute;
            left: 50%;
            bottom: 1.5rem;
            transform: translateX(-50%);
            z-index: 10;
            background: rgba(20, 18, 16, 0.88);
            color: #ffffff;
            border: 2px solid #febe10;
            border-radius: 999px;
            padding: 0.55rem 1.25rem;
            font-size: 0.85rem;
            font-weight: 700;
            white-space: nowrap;
            pointer-events: none;
        }
    </style>
{% endblock %}

{% block body %}
<section class="py-24 bg-white text-brandDark">
    <div class="container-xxl px-4">
        <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
            <span class="bg-brandDark text-brandYellow text-xs font-black uppercase tracking-widest px-3.5 py-1.5 rounded-full shadow">Visit Our Store</span>
            <h2 class="text-4xl font-extrabold tracking-tight text-brandDark">Location & Hours</h2>
            <div class="w-16 h-1.5 bg-brandDark mx-auto rounded-pill"></div>
        </div>

        <div class="bg-brandYellow rounded-[2.5rem] p-6 lg:p-12 shadow-2xl border-4 border-brandDark/10 space-y-10">
            <div class="door-entry-stage shadow-2xl" id="doorStage">
                <div class="door-camera" id="doorCamera">
                    <div class="facade-wall">
                        <div class="facade-sign">
                            <div class="brand-title">every cup.</div>
                            <div class="brand-sub">Coffee &amp; Pastries</div>
                        </div>

                        <div class="side-window" aria-hidden="true">
                            <span></span><span></span>
                            <span></span><span></span>
                            <span></span><span></span>
                        </div>

                        <div class="doorway-opening">
                            <div class="door-panel" id="doorPanel">
                                <div class="door-glass-pane"></div>
                                <div class="door-handle"></div>
                            </div>
                        </div>

                        <div class="entry-steps" aria-hidden="true">
                            <div class="entry-step"></div>
                            <div class="entry-step"></div>
                            <div class="entry-step"></div>
                        </div>
                    </div>
                </div>

                <div class="door-caption" id="doorCaption">Scroll down to approach &amp; open the door</div>
            </div>

            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="bg-white p-6 lg:p-8 rounded-3xl border-2 border-brandDark shadow-xl space-y-5">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <h4 class="text-xl lg:text-2xl font-black text-brandDark mb-0">{{ store.name|default('every cup.') }}</h4>
                            <span class="badge bg-brandDark text-brandYellow px-3 py-1.5 rounded-pill fw-bold text-xs uppercase tracking-wider">UST Area</span>
                        </div>

                        <div class="space-y-4 pt-2">
                            <div class="d-flex align-items-start gap-3">
                                <div class="bg-brandYellow text-brandDark p-2 rounded-xl fw-bold fs-5 shadow-xs border border-brandDark">📍</div>
                                <div>
                                    <strong class="text-brandDark d-block mb-0.5">Address</strong>
                                    <p class="text-secondary text-sm mb-0">{{ store.address|default('466, 1125 Tolentino St, Sampaloc, Manila') }}</p>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3">
                                <div class="bg-brandYellow text-brandDark p-2 rounded-xl fw-bold fs-5 shadow-xs border border-brandDark">🕒</div>
                                <div>
                                    <strong class="text-brandDark d-block mb-0.5">Operating Hours</strong>
                                    <p class="text-secondary text-sm mb-0 font-semibold text-brandDark">{{ store.hours|default('Open daily') }}</p>
                                </div>
                            </div>
                        </div>

                        <div class="pt-4 border-top border-dark border-opacity-10">
                            <a href="{{ store.maps_url|default('https://maps.google.com/?q=14.604,120.988') }}" target="_blank" rel="noopener noreferrer" class="btn bg-brandDark text-brandYellow fw-bold px-4 py-3 rounded-2xl hover:bg-black transition shadow-md border-0 w-100 d-flex align-items-center justify-content-center gap-2">
                                <span>🗺️</span> Open Google Maps Direction
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="h-96 rounded-3xl overflow-hidden border-4 border-brandDark shadow-2xl bg-white">
                        <iframe title="Store Location Map" class="w-100 h-100 filter contrast-125" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3860.912!2d120.988!3d14.604!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTTCsDM2JzE0LjQiTiAxMjDCsDU5JzE2LjgiRQ!5e0!3m2!1sen!2sph!4v1234567890" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const stage = document.getElementById('doorStage');
            const camera = document.getElementById('doorCamera');
            const doorPanel = document.getElementById('doorPanel');
            const caption = document.getElementById('doorCaption');

            if (!stage || !camera || !doorPanel || typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
                return;
            }

            gsap.registerPlugin(ScrollTrigger);

            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: stage,
                    start: 'top 14%',
                    end: '+=1400',
                    pin: true,
                    scrub: 1.1
                }
            });

            // 1. Walk up toward the entrance door
            tl.to(camera, {
                scale: 2.1,
                z: 220,
                rotateY: -5,
                rotateX: 2,
                duration: 0.65,
                ease: 'power1.inOut'
            }, 0)

            // 2. Swing the door open in 3D space (hinged on the right)
            .to(doorPanel, {
                rotateY: -82,
                duration: 0.65,
                ease: 'power2.inOut'
            }, 0.25)

            // 3. Update status label mid-scroll
            .to(caption, {
                opacity: 0,
                y: -8,
                duration: 0.25,
                onComplete: function () {
                    caption.textContent = 'Door opening...';
                }
            }, 0.2)
            .to(caption, {
                opacity: 1,
                y: 0,
                duration: 0.25
            }, 0.48);
        });
    </script>
{% endblock %}