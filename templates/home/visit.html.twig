{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script>
    (function () {
        'use strict';
        var root = document.getElementById('ec');
        if (!root) return;
        var $ = function (s, c) { return (c || root).querySelector(s); };
        var $$ = function (s, c) { return Array.prototype.slice.call((c || root).querySelectorAll(s)); };
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var hasGsap = !!(window.gsap && window.ScrollTrigger);
        var NS = 'http://www.w3.org/2000/svg';
        var stage = $('#stage'), toastEl = $('#toast');

        /* ---------- tiny helpers ---------- */
        function rng(seed) { return function () { seed |= 0; seed = seed + 0x6D2B79F5 | 0; var t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
        var toastTimer;
        function say(msg) { toastEl.textContent = msg; toastEl.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(function () { toastEl.classList.remove('show'); }, 2800); }
        function scrollToEl(el) { el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' }); }

        /* ---------- skyline + stars ---------- */
        function skyline(id, seed, base, hMin, hMax, fill, lit) {
            var g = document.getElementById(id), r = rng(seed), x = -40, out = '';
            while (x < 1650) {
                var w = 60 + r() * 90, h = hMin + r() * (hMax - hMin), y = base - h;
                out += '<rect x="' + x.toFixed(0) + '" y="' + y.toFixed(0) + '" width="' + w.toFixed(0) + '" height="' + h.toFixed(0) + '" fill="' + fill + '"/>';
                for (var wy = y + 16; wy < base - 18; wy += 24) for (var wx = x + 10; wx < x + w - 14; wx += 18)
                    if (r() < lit) out += '<rect x="' + wx.toFixed(0) + '" y="' + wy.toFixed(0) + '" width="7" height="10" fill="#ffd37a" opacity="' + (0.35 + r() * 0.55).toFixed(2) + '"/>';
                x += w + 4;
            }
            g.innerHTML = out;
        }
        skyline('skyFar', 11, 720, 160, 330, '#3a2748', 0.10);
        skyline('skyNear', 23, 710, 90, 230, '#2a1c33', 0.16);
        (function () { var r = rng(5), s = ''; for (var i = 0; i < 46; i++) s += '<circle cx="' + (r() * 1600).toFixed(0) + '" cy="' + (r() * 300).toFixed(0) + '" r="' + (0.6 + r() * 1.4).toFixed(1) + '" opacity="' + (0.3 + r() * 0.6).toFixed(2) + '"/>'; $('#stars').innerHTML = s; })();

        /* ---------- open / closed status (Manila time) ---------- */
        function toMin(s) { var p = s.split(':'); return (+p[0]) * 60 + (+p[1]); }
        function fmt(s) { var m = toMin(s), h = Math.floor(m / 60) % 24, mm = m % 60, ap = h >= 12 ? 'PM' : 'AM'; h = h % 12 || 12; return h + ':' + (mm < 10 ? '0' : '') + mm + ' ' + ap; }
        function updateStatus() {
            var o = toMin(root.dataset.openAt), c = toMin(root.dataset.closeAt), now;
            try {
                var parts = new Intl.DateTimeFormat('en-GB', { timeZone: root.dataset.tz, hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
                now = (+parts.filter(function (p) { return p.type === 'hour'; })[0].value % 24) * 60 + (+parts.filter(function (p) { return p.type === 'minute'; })[0].value);
            } catch (e) { var d = new Date(); now = d.getHours() * 60 + d.getMinutes(); }
            var open = c > o ? (now >= o && now < c) : (now >= o || now < c);
            root.dataset.open = open ? 'true' : 'false';
            var left = (c - now + 1440) % 1440, txt;
            if (open) txt = left <= 60 ? 'Open now, closing soon at ' + fmt(root.dataset.closeAt) : 'Open now, until ' + fmt(root.dataset.closeAt);
            else txt = 'Closed right now, opens at ' + fmt(root.dataset.openAt);
            $$('.js-status').forEach(function (n) { n.textContent = txt; });
            var neon = $('#neon'), nt = $('#neonT');
            if (neon) { neon.classList.toggle('is-off', !open); nt.textContent = open ? 'open' : 'closed'; }
        }
        updateStatus(); setInterval(updateStatus, 60000);

        /* ---------- directions + copy ---------- */
        var dest = root.dataset.dest;
        $$('input[type="radio"][name^="mode"]').forEach(function (r) {
            r.addEventListener('change', function () {
                $$('.js-dir').forEach(function (a) { a.href = 'https://www.google.com/maps/dir/?api=1&destination=' + dest + '&travelmode=' + r.value; });
                $$('input[type="radio"][name^="mode"]').forEach(function (o) { o.checked = (o.value === r.value); });
            });
        });
        var copyAddr = $('#copyAddr');
        if (copyAddr) copyAddr.addEventListener('click', function () {
            var t = this.dataset.text, b = this;
            function done() { var old = b.textContent; b.textContent = 'Copied'; setTimeout(function () { b.textContent = old; }, 1800); }
            if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(t).then(done, done);
            else { var ta = document.createElement('textarea'); ta.value = t; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); } catch (e) {} ta.remove(); done(); }
        });

        /* ---------- hotspots (markers, cups, menu, case) ---------- */
        function burst(g) {
            if (reduce || !hasGsap) return;
            var host = $('.burst', g); if (!host) return;
            for (var i = 0; i < 7; i++) {
                var c = document.createElementNS(NS, 'circle');
                c.setAttribute('cx', (Math.random() * 40 - 20).toFixed(1)); c.setAttribute('cy', '-18'); c.setAttribute('r', (5 + Math.random() * 6).toFixed(1)); c.setAttribute('fill', '#fff');
                host.appendChild(c);
                gsap.fromTo(c, { opacity: .55, y: 0, scale: .6 }, { opacity: 0, y: -60 - Math.random() * 40, scale: 1.8, duration: 1.6 + Math.random() * .6, delay: i * .07, ease: 'power1.out', onComplete: (function (n) { return function () { n.remove(); }; })(c) });
            }
        }
        var tl = null;
        function goInside() {
            if (!tl || !tl.scrollTrigger) { scrollToEl($('#visit')); return; }
            var st = tl.scrollTrigger;
            if (window.innerWidth <= 860) {
                var infoY = st.start + (st.end - st.start) * .97;
                window.scrollTo({ top: infoY, behavior: reduce ? 'auto' : 'smooth' });
                return;
            }
            if (st.progress > .5) { say('You are already inside.'); return; }
            var y = st.start + (st.end - st.start) * (4.9 / tl.duration());
            window.scrollTo({ top: y, behavior: reduce ? 'auto' : 'smooth' });
        }
        $$('.hot, .marker').forEach(function (el) {
            el.addEventListener('click', function (e) {
                if (el.id === 'door') { goInside(); return; }
                if (el.dataset.go === 'visit') { scrollToEl($('#visit')); return; }
                if (el.id === 'cupOut' || el.id === 'cupIn') burst(el);
                if (el.dataset.say) say(el.dataset.say);
            });
            el.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); el.dispatchEvent(new MouseEvent('click', { bubbles: true })); } });
        });
        $$('.skip').forEach(function (a) { a.addEventListener('click', function (e) { e.preventDefault(); scrollToEl($('#visit')); }); });

        /* ---------- ambient particles (dust motes + bokeh) ---------- */
        var cv = $('#fx'), ctx = cv.getContext('2d'), W = 0, H = 0, dpr = Math.min(window.devicePixelRatio || 1, 2), parts = [], visible = true, tick = 0;
        var sprite = document.createElement('canvas'); sprite.width = sprite.height = 64;
        (function () { var g = sprite.getContext('2d'), gr = g.createRadialGradient(32, 32, 0, 32, 32, 32); gr.addColorStop(0, 'rgba(255,225,160,1)'); gr.addColorStop(.4, 'rgba(255,190,100,.45)'); gr.addColorStop(1, 'rgba(255,170,80,0)'); g.fillStyle = gr; g.fillRect(0, 0, 64, 64); })();
        function sizeFx() { W = stage.clientWidth; H = stage.clientHeight; cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); }
        function seedParts() { var n = W < 700 ? 34 : 70, r = Math.random; parts = []; for (var i = 0; i < n; i++) parts.push({ x: r() * W, y: r() * H, s: 4 + r() * (i % 6 === 0 ? 46 : 14), v: .1 + r() * .35, a: .12 + r() * .5, f: .4 + r() * 1.2, p: r() * 6.28 }); }
        function frame() {
            requestAnimationFrame(frame);
            if (!visible || document.hidden) return;
            tick += .016; ctx.clearRect(0, 0, W, H);
            for (var i = 0; i < parts.length; i++) {
                var p = parts[i]; p.y -= p.v; p.x += Math.sin(tick * p.f + p.p) * .25;
                if (p.y < -60) { p.y = H + 40; p.x = Math.random() * W; }
                ctx.globalAlpha = p.a * (p.s > 20 ? .35 : 1) * (.7 + .3 * Math.sin(tick * p.f * 2 + p.p));
                ctx.drawImage(sprite, p.x - p.s, p.y - p.s, p.s * 2, p.s * 2);
            }
        }
        sizeFx(); seedParts();
        if (!reduce) { frame(); if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { visible = e[0].isIntersecting; }).observe(stage); }
        window.addEventListener('resize', function () { sizeFx(); seedParts(); });

        /* ---------- static fallback ---------- */
        function makeStatic() {
            root.classList.add('is-static');
            var l = $('#loader'); if (l) l.remove();
            document.documentElement.classList.remove('ec-lock');
            gsapSafeShow();
        }
        function gsapSafeShow() { $$('.int, .ext').forEach(function (e) { e.style.opacity = 1; e.style.visibility = 'visible'; }); }
        if (reduce || !hasGsap) { makeStatic(); return; }

        /* ---------- GSAP: loader, intro, scroll journey ---------- */
        gsap.registerPlugin(ScrollTrigger);
        var loader = $('#loader'), lFill = $('#lFill'), lFoam = $('#lFoam'), lPct = $('#lPct'), state = { p: 0 };
        function drawLoader() { var y = 150 - 118 * state.p; lFill.setAttribute('y', y); lFoam.setAttribute('y', y - 2); lPct.textContent = Math.round(state.p * 100); }
        var assets = Promise.all([
            document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve(),
            new Promise(function (res) { if (document.readyState === 'complete') res(); else window.addEventListener('load', res); }),
            new Promise(function (res) { setTimeout(res, 6000); })
        ].slice(0, 2));
        var timeout = new Promise(function (res) { setTimeout(res, 6000); });

        gsap.set('.ext-svg', { opacity: 0 });
        gsap.to(state, { p: .9, duration: 1.7, ease: 'power2.out', onUpdate: drawLoader, onComplete: function () {
            Promise.race([assets, timeout]).then(function () {
                gsap.to(state, { p: 1, duration: .5, onUpdate: drawLoader, onComplete: reveal });
            });
        } });

        function reveal() {
            var intro = gsap.timeline();
            intro.to(loader, { yPercent: -100, duration: 1.1, ease: 'power4.inOut', onComplete: function () { loader.remove(); document.documentElement.classList.remove('ec-lock'); ScrollTrigger.refresh(); } })
                 .fromTo('.ext-svg', { opacity: 0, scale: 1.07 }, { opacity: 1, scale: 1, duration: 2.4, ease: 'power3.out' }, .35)
                 .fromTo('.sign-halo', { opacity: 0 }, { opacity: .55, duration: 1.4, ease: 'power2.inOut' }, 1.2)
                 .fromTo('.cap-1', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 1.1, ease: 'power3.out' }, 1.3)
                 .to('.hint', { opacity: 1, duration: .8 }, 2.0);
        }

        /* camera origin = the door, whatever the viewport crop */
        var camExt = $('#camExt'), camInt = $('#camInt');
        function setOrigin() {
            var w = stage.clientWidth, h = stage.clientHeight, s = Math.max(w / 1600, h / 900);
            gsap.set(camExt, { transformOrigin: ((w - 1600 * s) / 2 + 850 * s) + 'px ' + ((h - 900 * s) / 2 + 540 * s) + 'px' });
        }
        setOrigin();
        ScrollTrigger.addEventListener('refreshInit', setOrigin);

        function narrow() { return window.innerWidth <= 860; }
        var rail = $('#railFill');
        tl = gsap.timeline({
            defaults: { ease: 'none' },
            scrollTrigger: {
                trigger: stage,
                start: 'top top',
                // Mobile keeps the scene in normal document flow. This
                // avoids pinned-layer overlap when a user flicks quickly.
                end: narrow() ? '+=100%' : '+=520%',
                pin: !narrow(),
                scrub: narrow() ? 1.15 : .8,
                anticipatePin: narrow() ? 0 : 1,
                invalidateOnRefresh: true,
                onUpdate: function (self) {
                    rail.style.transform = 'scaleY(' + self.progress.toFixed(3) + ')';
                    stage.classList.toggle('is-inside', self.progress > .6);
                    $('#ext').style.pointerEvents = self.progress > .42 ? 'none' : '';
                }
            }
        });
        tl.fromTo(camExt, { scale: 1 }, { scale: 4.2, ease: 'power2.in', duration: 5 }, 0)
          .to('.cap-1', { autoAlpha: 0, y: -24, duration: .7, ease: 'power1.out' }, .5)
          .to('.hint', { autoAlpha: 0, duration: .4 }, .3)
          .fromTo('.cap-2', { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: .8, ease: 'power1.out' }, 2.2)
          .to('.cap-2', { autoAlpha: 0, y: -24, duration: .6 }, 4.2)
          .fromTo('#door', { scaleX: 1, skewY: 0, svgOrigin: '770 540' }, { scaleX: .16, skewY: 7, svgOrigin: '770 540', duration: 1.8, ease: 'power2.inOut' }, 3.2)
          .fromTo('.flash', { opacity: 0 }, { opacity: .85, duration: .6 }, 4.3)
          .fromTo('#int', { autoAlpha: 0 }, { autoAlpha: 1, duration: 1.2 }, 4.7)
          .fromTo(camInt, { scale: 1.5 }, { scale: 1, duration: 2.6, ease: 'power2.out' }, 4.6)
          .to('#ext', { autoAlpha: 0, duration: 1.2, ease: 'power1.in' }, 5.1)
          .to('.flash', { opacity: 0, duration: 1.2 }, 4.9)
          .fromTo('.cap-4', { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: .8, ease: 'power1.out' }, 6.2)
          .fromTo('.scene-sleeve', { autoAlpha: 0, y: 40, yPercent: narrow() ? 0 : -50 }, { autoAlpha: 1, y: 0, yPercent: narrow() ? 0 : -50, duration: .9, ease: 'power2.out' }, 6.1)
          .to({}, { duration: .001 }, 10);

        /* ---------- mouse parallax ---------- */
        if (window.matchMedia('(pointer: fine)').matches) {
            var layers = [['#pxSky', 6], ['#pxFar', 12], ['#pxMid', 20], ['#furn', -26], ['#mk', -10], ['#pxIntBack', 12], ['#pxIntFront', -24]].map(function (l) {
                var el = $(l[0]); return el ? { x: gsap.quickTo(el, 'x', { duration: .9, ease: 'power3.out' }), y: gsap.quickTo(el, 'y', { duration: .9, ease: 'power3.out' }), d: l[1] } : null;
            }).filter(Boolean);
            stage.addEventListener('pointermove', function (e) {
                var nx = e.clientX / window.innerWidth - .5, ny = e.clientY / window.innerHeight - .5;
                layers.forEach(function (l) { l.x(nx * l.d * 2); l.y(ny * l.d); });
            });
        }

        /* ---------- map: illustrated map melts into the real one ---------- */
        var layersEl = $('#mapLayers');
        gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: {
            trigger: '#mapstage', start: 'top 80%', end: 'top 10%', scrub: true,
            onUpdate: function (self) { layersEl.classList.toggle('is-live', self.progress > .75); }
        } })
            .fromTo('#mapArt', { scale: 1, opacity: 1 }, { scale: 2.6, opacity: 0, transformOrigin: '50% 50%', duration: 1 }, 0)
            .fromTo('#mapLive', { opacity: 0, scale: 1.18 }, { opacity: 1, scale: 1, transformOrigin: '50% 50%', duration: 1 }, .2)
            .fromTo('#pin', { scale: 1.25, y: 0 }, { scale: 1, duration: .8 }, 0)
            .to('#pin', { opacity: 0, duration: .25 }, .8);

        window.addEventListener('resize', function () { ScrollTrigger.refresh(); });
    })();
    </script>
{% endblock %}
