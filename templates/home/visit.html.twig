{% extends 'base.html.twig' %}

{# ------------------------------------------------------------------
   Visit us: every cup
   Optional: pass a `cafe` array from your controller to override any value.
------------------------------------------------------------------- #}
{% set cafe = {
    name: 'every cup',
    address_line1: '1125 G. Tolentino St.',
    address_line2: 'Sampaloc, Manila',
    phone_display: '0961 636-7870',
    phone_tel: '+639616367870',
    maps_short: 'https://maps.app.goo.gl/cNd44mXPCEFiQHNa7',
    hours_open: '11:00',
    hours_close: '23:00',
    hours_label: '11:00 AM – 11:00 PM',
    hours_days: 'Monday to Sunday',
    timezone: 'Asia/Manila'
}|merge(cafe|default({})) %}
{% set mapQuery = (cafe.address_line1 ~ ', ' ~ cafe.address_line2 ~ ', Philippines')|url_encode %}

{% block title %}Visit us | {{ cafe.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        html.ec-lock { overflow: hidden; }
        body { overflow-x: clip; }

        .ec {
            --mustard: #F4B81C; --mustard-2: #D99A06; --espresso: #1E1510; --roast: #33241A;
            --kraft: #D2A26B; --kraft-2: #B98550; --milk: #F7EBD6; --ember: #FF6B4A;
            position: relative; width: 100vw; left: 50%; margin-left: -50vw;
            background: var(--espresso); color: var(--milk);
            font-family: 'Outfit', system-ui, sans-serif; line-height: 1.5; overflow-x: clip;
        }
        .ec *, .ec *::before, .ec *::after { box-sizing: border-box; }
        .ec a { color: inherit; }
        .ec .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        .ec :focus-visible { outline: 3px solid var(--mustard); outline-offset: 3px; }

        /* ---------- Loader ---------- */
        .loader { display: none; position: fixed; inset: 0; z-index: 1000; background: #120d0a; place-items: center; align-content: center; gap: 18px; text-align: center; }
        .js .loader { display: grid; }
        .loader svg { width: 120px; height: 160px; overflow: visible; }
        .l-wisp { fill: none; stroke: #f7ebd6; stroke-width: 3; stroke-linecap: round; opacity: 0; animation: steam 2.6s ease-in-out infinite; transform-box: fill-box; transform-origin: 50% 100%; }
        .l-wisp:nth-of-type(2) { animation-delay: .8s; } .l-wisp:nth-of-type(3) { animation-delay: 1.6s; }
        .l-name { font-size: 30px; font-weight: 800; letter-spacing: -.02em; line-height: 1; }
        .l-sub { font-size: 15px; color: #d9c4a3; }

        /* ---------- Scene ---------- */
        html:not(.js) .stage { display: none; }
        .stage { position: relative; height: 100vh; height: 100svh; overflow: hidden; background: #120d0a; isolation: isolate; }
        .layer { position: absolute; inset: 0; overflow: hidden; }
        .cam { position: absolute; inset: 0; }
        .cam svg { display: block; width: 100%; height: 100%; }
        .int { visibility: hidden; opacity: 0; }
        #fx { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 3; mix-blend-mode: screen; }
        .shade { position: absolute; inset: 0; pointer-events: none; z-index: 4;
            background: radial-gradient(120% 90% at 50% 45%, transparent 55%, rgba(0,0,0,.55) 100%), linear-gradient(to top, rgba(10,6,4,.75), transparent 38%); }
        .flash { position: absolute; inset: 0; pointer-events: none; z-index: 5; opacity: 0; background: radial-gradient(circle at 50% 58%, #ffe1a8 0%, #ff9a4a 38%, transparent 72%); }

        .cap { position: absolute; left: clamp(20px, 5vw, 80px); bottom: clamp(36px, 9vh, 100px); z-index: 6; max-width: 16ch;
            font-size: clamp(30px, 5vw, 76px); font-weight: 700; line-height: 1; letter-spacing: -.035em; color: #fff3dc; text-shadow: 0 4px 30px rgba(0,0,0,.55); pointer-events: none; }
        .cap small { display: block; margin-top: .6em; font-size: clamp(15px, 1.4vw, 20px); font-weight: 500; letter-spacing: 0; line-height: 1.35; max-width: 32ch; color: #f0dcb8; }
        .cap-2, .cap-3, .cap-4 { visibility: hidden; opacity: 0; }
        .hint { position: absolute; right: clamp(20px, 5vw, 80px); bottom: clamp(36px, 9vh, 100px); z-index: 6; display: flex; align-items: center; gap: 12px; font-size: 16px; font-weight: 500; color: #f0dcb8; pointer-events: none; opacity: 0; }
        .hint i { width: 2px; height: 46px; background: linear-gradient(var(--mustard), transparent); transform-origin: top; animation: drip 1.8s ease-in-out infinite; }
        @keyframes drip { 0% { transform: scaleY(0); } 60% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
        .skip { position: absolute; top: 16px; right: 16px; z-index: 7; padding: .5em 1em; border-radius: 999px; background: rgba(20,14,10,.6); border: 1px solid rgba(247,235,214,.35); color: var(--milk); font-size: 15px; font-weight: 500; text-decoration: none; backdrop-filter: blur(6px); }
        .skip:hover { background: var(--mustard); color: #1e1510; }
        .rail { position: absolute; right: max(14px, 2vw); top: 50%; height: 140px; width: 3px; transform: translateY(-50%); background: rgba(247,235,214,.22); border-radius: 2px; z-index: 6; }
        .rail i { position: absolute; inset: 0; background: var(--mustard); transform-origin: top; transform: scaleY(0); border-radius: 2px; }
        .toast { position: absolute; left: 50%; top: 22px; z-index: 8; transform: translate(-50%, -20px); opacity: 0; padding: .65em 1.2em; border-radius: 999px; background: var(--mustard); color: #1e1510; font-weight: 600; font-size: 16px; pointer-events: none; transition: .35s; max-width: 90vw; text-align: center; }
        .toast.show { opacity: 1; transform: translate(-50%, 0); }

        /* SVG details */
        .sign-t { font-family: 'Outfit', sans-serif; font-weight: 800; fill: #2a1f17; letter-spacing: -2px; }
        .sign-halo { opacity: .55; transition: opacity .4s; }
        .sign:hover .sign-halo { opacity: 1; }
        .cone { animation: flick 7s infinite; }
        @keyframes flick { 0%, 100% { opacity: .9; } 46% { opacity: 1; } 48% { opacity: .55; } 50% { opacity: 1; } 78% { opacity: .85; } }
        .neon-t { font: 700 26px 'Outfit', sans-serif; fill: #ffe3d6; stroke: #ff6b4a; stroke-width: 5; paint-order: stroke; stroke-linejoin: round; }
        .neon { transition: opacity .6s; }
        .neon.is-off { opacity: .28; }
        .chalk { font-family: 'Caveat Brush', cursive; fill: #f4f1e8; }
        .menu-t { font-family: 'Outfit', sans-serif; font-weight: 700; fill: #2a1f17; }
        .cup-t { font-family: 'Outfit', sans-serif; font-weight: 800; fill: #2a1a10; letter-spacing: -.5px; }
        .hot { cursor: pointer; outline: none; }
        .hot .ring { fill: none; stroke: #F4B81C; stroke-width: 3; stroke-dasharray: 8 6; opacity: 0; transition: opacity .25s; }
        .hot:hover .ring, .hot:focus-visible .ring { opacity: 1; }
        .doorhover { fill: #ffd56a; opacity: 0; transition: opacity .3s; }
        .door:hover .doorhover, .door:focus-visible .doorhover { opacity: .16; }
        .int .hot { pointer-events: none; }
        .stage.is-inside .int .hot { pointer-events: auto; }
        .dot .core { fill: #F4B81C; }
        .dot .pulse { fill: none; stroke: #F4B81C; stroke-width: 2; transform-box: fill-box; transform-origin: center; animation: pulse 2.2s ease-out infinite; }
        @keyframes pulse { from { transform: scale(.6); opacity: .9; } to { transform: scale(2.8); opacity: 0; } }
        .bob { animation: bob 4s ease-in-out infinite; }
        .marker:nth-of-type(2) .bob { animation-delay: -1.3s; } .marker:nth-of-type(3) .bob { animation-delay: -2.4s; }
        @keyframes bob { 50% { transform: translateY(-10px); } }
        .marker { cursor: pointer; outline: none; }
        .marker .pill { fill: rgba(22,15,10,.8); stroke: #F4B81C; stroke-width: 1.5; transition: fill .25s; }
        .marker:hover .pill, .marker:focus-visible .pill { fill: #F4B81C; }
        .marker:hover .m-t, .marker:focus-visible .m-t { fill: #1e1510; }
        .m-t { font: 600 20px 'Outfit', sans-serif; fill: #f7ebd6; transition: fill .25s; }
        .steam path { fill: none; stroke: #fff; stroke-width: 3; stroke-linecap: round; opacity: 0; animation: steam 3.2s ease-in-out infinite; transform-box: fill-box; transform-origin: 50% 100%; }
        .steam path:nth-child(2) { animation-delay: 1s; } .steam path:nth-child(3) { animation-delay: 2s; }
        @keyframes steam { 0% { opacity: 0; transform: translateY(8px) scaleY(.8); } 30% { opacity: .55; } 100% { opacity: 0; transform: translateY(-34px) scaleY(1.2); } }
        .chair { transform-box: fill-box; transform-origin: 50% 100%; transition: transform .5s cubic-bezier(.3, 1.6, .5, 1); }
        .chair:hover { transform: rotate(-3deg); }
        .pend { transform-box: fill-box; transform-origin: 50% 0; animation: swing 6s ease-in-out infinite alternate; }
        @keyframes swing { from { transform: rotate(-2.2deg); } to { transform: rotate(2.2deg); } }
        #blade { transform-box: fill-box; transform-origin: 0 0; animation: sway 5s ease-in-out infinite alternate; }
        @keyframes sway { from { transform: rotate(-1.6deg); } to { transform: rotate(1.6deg); } }
        .glow-pulse { animation: glowp 5s ease-in-out infinite; }
        @keyframes glowp { 50% { opacity: .65; } }

        /* ---------- Visit section ---------- */
        .visit { position: relative; padding: clamp(64px, 10vw, 140px) clamp(16px, 4vw, 56px) clamp(56px, 8vw, 110px); background: linear-gradient(#120d0a, #1E1510 18%); }
        .visit-head { max-width: 1280px; margin: 0 auto clamp(24px, 4vw, 48px); }
        .visit-head h2 { margin: 0 0 .35em; font-size: clamp(36px, 6vw, 88px); font-weight: 700; line-height: .98; letter-spacing: -.04em; max-width: 13ch; }
        .visit-head p { margin: 0; font-size: clamp(17px, 1.6vw, 21px); max-width: 44ch; color: #e8d6b9; }
        .mapstage { position: relative; max-width: 1280px; margin: 0 auto; }
        .map-layers { position: relative; height: clamp(480px, 74vh, 740px); border-radius: 26px; overflow: hidden; background: #2a2019; box-shadow: 0 50px 90px -40px #000, inset 0 0 0 1px rgba(247,235,214,.12); }
        .map-art, .map-live { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
        .map-live { opacity: 0; pointer-events: none; filter: saturate(.85) sepia(.12) contrast(1.02); }
        .map-layers.is-live .map-live { pointer-events: auto; }
        .pin { position: absolute; left: 50%; top: 50%; width: 54px; height: 70px; margin: -66px 0 0 -27px; z-index: 3; pointer-events: none; }
        .pin svg { width: 100%; height: 100%; overflow: visible; animation: hop 2.4s cubic-bezier(.3, 0, .3, 1) infinite; }
        @keyframes hop { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-14px); } 55% { transform: translateY(0); } }
        .pin::after { content: ''; position: absolute; left: 50%; bottom: -6px; width: 40px; height: 12px; margin-left: -20px; border-radius: 50%; border: 2px solid var(--mustard); animation: ripple 2.4s ease-out infinite; }
        @keyframes ripple { from { transform: scale(.3); opacity: 1; } to { transform: scale(2.2); opacity: 0; } }
        .map-note { position: absolute; right: 16px; bottom: 14px; z-index: 4; margin: 0; padding: .4em .9em; border-radius: 999px; background: rgba(20,14,10,.75); color: var(--milk); font-size: 14px; opacity: 0; transition: opacity .4s; pointer-events: none; }
        .map-layers.is-live .map-note { opacity: 1; }

        .sleeve { position: absolute; z-index: 5; left: clamp(12px, 2.2vw, 30px); top: 50%; transform: translateY(-50%); width: min(390px, calc(100% - 24px));
            padding: 38px 24px 22px; color: #2a1a0f; border-radius: 20px 20px 26px 26px;
            background: linear-gradient(#d9ab73, #c79560); box-shadow: 0 30px 60px -20px rgba(0,0,0,.7); }
        .sleeve::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 16px; border-radius: 20px 20px 0 0; background: repeating-linear-gradient(90deg, rgba(42,26,15,.16) 0 3px, transparent 3px 8px); }
        .sleeve h3 { margin: 0 0 6px; font-size: 26px; font-weight: 800; letter-spacing: -.02em; line-height: 1.05; }
        .row { padding: 14px 0; border-top: 2px dashed rgba(42,26,15,.32); }
        .row:first-of-type { margin-top: 10px; }
        .lbl { display: block; font-size: 15px; font-weight: 600; opacity: .78; margin-bottom: 2px; }
        .val { font-size: 20px; font-weight: 600; line-height: 1.25; }
        .val-sm { font-size: 17px; font-weight: 500; }
        .status { display: inline-flex; align-items: center; gap: .55em; font-weight: 700; margin-top: 4px; }
        .status i { width: 11px; height: 11px; border-radius: 50%; background: #1f8f4e; animation: ping 2s infinite; }
        .ec[data-open="false"] .status i { background: #b3261e; animation: none; }
        @keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(31,143,78,.6); } 100% { box-shadow: 0 0 0 12px rgba(31,143,78,0); } }
        .btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5em; padding: .62em 1.15em; border-radius: 999px; border: 2px solid #2a1a0f; background: transparent; color: #2a1a0f; font: 600 16px 'Outfit', sans-serif; text-decoration: none; cursor: pointer; transition: transform .2s, background .2s, color .2s; }
        .btn:hover { transform: translateY(-2px); background: rgba(42,26,15,.1); }
        .btn.primary { background: #2a1a0f; color: #f7ebd6; }
        .btn.primary:hover { background: #3d2818; }
        .modes { display: flex; margin-top: 10px; border: 2px solid #2a1a0f; border-radius: 999px; overflow: hidden; }
        .modes label { flex: 1; position: relative; cursor: pointer; }
        .modes input { position: absolute; opacity: 0; }
        .modes span { display: block; padding: .45em .2em; text-align: center; font-weight: 600; font-size: 15px; transition: background .2s, color .2s; }
        .modes input:checked + span { background: #2a1a0f; color: #f7ebd6; }
        .modes input:focus-visible + span { outline: 3px solid var(--mustard); outline-offset: -4px; }
        .signoff { max-width: 1280px; margin: clamp(48px, 7vw, 96px) auto 0; font-size: clamp(26px, 4vw, 56px); font-weight: 700; letter-spacing: -.035em; line-height: 1.05; }
        .signoff small { display: block; margin-top: .5em; font-size: 17px; font-weight: 400; letter-spacing: 0; color: #d9c4a3; }

        .scene-sleeve { position: absolute; z-index: 7; left: auto; right: clamp(16px, 5vw, 80px); top: 50%; transform: translateY(-50%); width: min(380px, calc(100% - 24px)); max-height: min(78svh, 700px); overflow: auto; visibility: hidden; opacity: 0; }
        .cap-4 { bottom: auto; top: clamp(96px, 20vh, 220px); }
        @media (max-width: 860px) {
            .scene-sleeve { top: auto; left: 12px; right: 12px; bottom: 12px; width: auto; max-height: 72vh; overflow: auto; margin: 0; }
            .cap-4 { display: none; }
            .sleeve { position: relative; left: auto; top: auto; transform: none; width: auto; margin: -64px 12px 0; }
            .map-layers { height: 62vh; min-height: 420px; }
            .hint { display: none; }
            .rail { display: none; }
        }

        /* ---------- Phone layout ---------- */
        @media (max-width: 575px) {
            .ec { width: 100%; left: auto; margin-left: 0; }
            .stage { min-height: 560px; }
            .skip { top: 10px; right: 10px; padding: .45em .8em; font-size: 13px; }
            .cap { left: 18px; right: 18px; bottom: 28px; max-width: 12ch; font-size: clamp(28px, 9vw, 48px); }
            .cap small { max-width: 27ch; font-size: 14px; }
            .toast { top: 14px; font-size: 14px; }
            .scene-sleeve { left: 50%; right: auto; top: 50%; bottom: auto; width: min(90vw, 380px); max-height: min(78svh, 600px); overflow: auto; transform: translate(-50%, -50%) !important; }
            .scene-sleeve .sleeve { width: 100%; margin: 0; padding: 24px 14px 14px; border-radius: 14px 14px 18px 18px; }
            .scene-sleeve .sleeve::before { height: 12px; border-radius: 16px 16px 0 0; }
            .scene-sleeve .sleeve h3 { font-size: 20px; }
            .scene-sleeve .row { padding: 8px 0; }
            .scene-sleeve .val { font-size: 15px; }
            .scene-sleeve .val-sm, .scene-sleeve .lbl { font-size: 12px; }
            .scene-sleeve .btns, .scene-sleeve .btn { width: 100%; }
            .scene-sleeve .btn { min-height: 40px; padding: .5em .85em; font-size: 14px; }
            .modes span { min-height: 36px; padding: .45em .15em; font-size: 12px; }

            .visit { padding: 52px 14px 64px; }
            .visit-head { margin-bottom: 22px; }
            .visit-head h2 { font-size: clamp(34px, 11vw, 52px); max-width: 11ch; }
            .visit-head p { font-size: 15px; }
            .map-layers { height: min(58svh, 420px); min-height: 300px; border-radius: 16px; }
            .pin { width: 44px; height: 57px; margin: -53px 0 0 -22px; }
            .map-note { right: 9px; bottom: 9px; max-width: calc(100% - 18px); font-size: 11px; }
            .sleeve { margin: -46px 10px 0; padding: 28px 18px 18px; border-radius: 16px 16px 20px 20px; }
            .sleeve h3 { font-size: 23px; }
            .row { padding: 11px 0; }
            .val { font-size: 18px; }
            .btns, .btn { width: 100%; }
            .btn { min-height: 44px; }
            .signoff { margin-top: 48px; font-size: clamp(28px, 9vw, 42px); }
            .signoff small { font-size: 14px; }
        }

        /* Keep the visit details available when animation scripts are blocked or reduced. */
        @media (max-width: 575px) {
            .ec.is-static .scene-sleeve {
                display: block;
                position: relative;
                left: auto;
                right: auto;
                bottom: auto;
                top: auto;
                width: auto;
                max-height: none;
                margin: 16px 10px 0;
                transform: none;
                visibility: visible;
                opacity: 1;
            }
        }

        @media (max-width: 380px) {
            .stage { min-height: 520px; }
            .scene-sleeve { max-height: 58svh; }
            .map-layers { min-height: 280px; }
            .visit { padding-inline: 12px; }
        }

        /* Reduced motion / no GSAP: show the scenes stacked, no pinning */
        .ec.is-static .stage { height: auto; }
        .ec.is-static .layer { position: relative; height: 70vh; opacity: 1; visibility: visible; }
        .ec.is-static .int .hot { pointer-events: auto; }
        .ec.is-static .scene-sleeve { display: none; }
        .ec.is-static .cap, .ec.is-static .hint, .ec.is-static .rail { display: none; }
        .ec.is-static .map-live { opacity: 1; pointer-events: auto; }
        .ec.is-static .map-art, .ec.is-static .pin { display: none; }
        @media (max-width: 575px) {
            .ec.is-static .scene-sleeve { display: block; position: relative; left: auto; right: auto; top: auto; bottom: auto; width: auto; max-height: none; margin: 16px 10px 0; transform: none; visibility: visible; opacity: 1; }
        }
        @media (prefers-reduced-motion: reduce) {
            .ec *, .ec *::before, .ec *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
        }
    </style>
{% endblock %}

{% block body %}
<script>document.documentElement.classList.add('js', 'ec-lock');</script>

<main class="ec" id="ec"
      data-open="true"
      data-open-at="{{ cafe.hours_open }}"
      data-close-at="{{ cafe.hours_close }}"
      data-tz="{{ cafe.timezone }}"
      data-dest="{{ mapQuery }}">

    <h1 class="sr-only">Visit {{ cafe.name }} at {{ cafe.address_line1 }}, {{ cafe.address_line2 }}</h1>

    {# ======================= LOADER ======================= #}
    <div class="loader" id="loader" role="status" aria-live="polite">
        <svg viewBox="0 0 120 160" aria-hidden="true">
            <defs>
                <clipPath id="lClip"><path d="M20 34 L100 34 L90 140 Q89 150 79 150 L41 150 Q31 150 30 140Z"/></clipPath>
            </defs>
            <path class="l-wisp" d="M46 24 q-8 -10 0 -18 t0 -18"/>
            <path class="l-wisp" d="M60 24 q-8 -10 0 -18 t0 -18"/>
            <path class="l-wisp" d="M74 24 q-8 -10 0 -18 t0 -18"/>
            <path d="M20 34 L100 34 L90 140 Q89 150 79 150 L41 150 Q31 150 30 140Z" fill="#2a1f17"/>
            <g clip-path="url(#lClip)">
                <rect id="lFill" x="0" y="150" width="120" height="120" fill="#7a4a26"/>
                <rect id="lFoam" x="0" y="150" width="120" height="5" fill="#d7a66e"/>
            </g>
            <path d="M20 34 L100 34 L90 140 Q89 150 79 150 L41 150 Q31 150 30 140Z" fill="none" stroke="#D2A26B" stroke-width="4" stroke-linejoin="round"/>
            <rect x="14" y="26" width="92" height="10" rx="5" fill="#f4efe6"/>
        </svg>
        <div class="l-name">{{ cafe.name }}</div>
        <div class="l-sub"><span id="lPct">0</span>% poured</div>
    </div>

    {# ======================= SCENE ======================= #}
    <section class="stage" id="stage" aria-label="Walk up to the café and step inside">

        {# ---------- INTERIOR ---------- #}
        <div class="layer int" id="int">
            <div class="cam" id="camInt">
<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Café interior with wood beams, glowing menu screens, a pastry case and a kraft coffee cup">
<defs>
    <linearGradient id="iWall" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7d8084"/><stop offset="1" stop-color="#46494d"/></linearGradient>
    <linearGradient id="iWood" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b17a40"/><stop offset="1" stop-color="#744a24"/></linearGradient>
    <linearGradient id="iWoodD" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5e3d1e"/><stop offset="1" stop-color="#2f1d0e"/></linearGradient>
    <linearGradient id="iCone" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffe2a6" stop-opacity=".6"/><stop offset="1" stop-color="#ffe2a6" stop-opacity="0"/></linearGradient>
    <linearGradient id="iScrA" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff6c8"/><stop offset="1" stop-color="#f6c230"/></linearGradient>
