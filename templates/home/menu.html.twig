{% extends 'base.html.twig' %}
{% block title %}Menu | every cup.{% endblock %}
{% block body %}
<section class="page-hero menu-page-hero"><div class="container-xxl px-4"><span class="section-eyebrow">THE EVERY CUP MENU</span><h1>Find your <em>favorite.</em></h1><p>Thoughtful drinks for slow mornings, quick catch-ups, and everything in between.</p></div></section>
<main class="menu-catalog section-padding"><div class="container-xxl px-4">
<div class="menu-toolbar"><div class="filter-tabs"><button class="filter-tab active" data-filter="All">All</button><button class="filter-tab" data-filter="Espresso-Based">Espresso-Based</button><button class="filter-tab" data-filter="Cold Brew">Cold Brew</button><button class="filter-tab" data-filter="Non-Coffee">Non-Coffee</button><button class="filter-tab" data-filter="Seasonal Specials">Seasonal Specials</button></div><input class="menu-search" id="menuSearch" type="search" placeholder="Search drinks or flavor notes…"></div>
<div class="menu-grid" id="menuGrid">{% for item in menuItems %}<article class="catalog-card" data-category="{{ item.category }}" data-search="{{ (item.name ~ ' ' ~ item.notes)|lower }}"><div class="catalog-image"><img src="{{ asset(item.image) }}" alt="{{ item.name }}"><span>{{ item.category }}</span></div><div class="catalog-body"><div class="catalog-title"><h2>{{ item.name }}</h2><strong>₱{{ item.price }}</strong></div><p>{{ item.notes }}</p><div class="catalog-controls"><select><option>Regular</option><option>Large +₱20</option></select><select><option>Normal ice</option><option>Less ice</option><option>No ice</option></select></div><button class="catalog-add" type="button" data-name="{{ item.name }}" data-price="{{ item.price }}">ADD TO ORDER <span>+</span></button></div></article>{% endfor %}</div>
</div></main>
<aside class="catalog-cart" id="catalogCart"><div class="cart-heading"><div><span class="section-eyebrow">YOUR ORDER</span><h2>Ready when you are.</h2></div><button class="cart-close" type="button">×</button></div><div id="catalogCartItems"><p class="empty-order">Your cart is waiting for its first cup.</p></div><div class="cart-total"><span>Subtotal</span><strong id="catalogCartTotal">₱0</strong></div><form id="catalogCheckout"><input required placeholder="Your name"><button class="btn-primary-custom" type="submit">CHECK OUT <span>→</span></button><p class="form-status" id="checkoutStatus"></p></form></aside>
{% endblock %}
{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded',()=>{const cards=[...document.querySelectorAll('.catalog-card')],tabs=[...document.querySelectorAll('.filter-tab')],search=document.getElementById('menuSearch');let filter='All';const apply=()=>{const q=search.value.toLowerCase();cards.forEach(c=>c.hidden=!((filter==='All'||c.dataset.category===filter)&&c.dataset.search.includes(q)))};tabs.forEach(t=>t.onclick=()=>{tabs.forEach(x=>x.classList.remove('active'));t.classList.add('active');filter=t.dataset.filter;apply()});search.oninput=apply;const cart=document.getElementById('catalogCart'),items={},list=document.getElementById('catalogCartItems'),total=document.getElementById('catalogCartTotal');function render(){let sum=0;list.innerHTML=Object.values(items).length?Object.values(items).map(i=>{sum+=i.p*i.q;return `<div class="cart-line"><span>${i.n} × ${i.q}</span><strong>₱${i.p*i.q}</strong></div>`}).join(''):'<p class="empty-order">Your cart is waiting for its first cup.</p>';total.textContent='₱'+sum}document.querySelectorAll('.catalog-add').forEach(b=>b.onclick=()=>{items[b.dataset.name]=items[b.dataset.name]||{n:b.dataset.name,p:+b.dataset.price,q:0};items[b.dataset.name].q++;render();cart.classList.add('open')});document.querySelector('.cart-close').onclick=()=>cart.classList.remove('open');document.getElementById('catalogCheckout').onsubmit=e=>{e.preventDefault();document.getElementById('checkoutStatus').textContent='Thanks — your order is being prepared.'}});
</script>
{% endblock %}
