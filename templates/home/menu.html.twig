{# templates/home/menu.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<section class="py-24 bg-white text-brandDark shadow-inner">
    <div class="container-xxl px-4">
        <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
            <span class="bg-brandYellow text-brandDark text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full border border-brandDark">Menu Catalog</span>
            <h2 class="text-4xl font-extrabold tracking-tight text-brandDark">Freshly Crafted For You</h2>
            <div class="w-16 h-1.5 bg-brandYellow mx-auto rounded-pill border border-brandDark"></div>
        </div>

        {% for category in menu_categories %}
            <div class="mb-16">
                <h3 class="text-2xl font-black text-brandDark mb-8 border-bottom border-dark border-opacity-10 pb-3 d-flex align-items-center gap-3">
                    <span class="d-inline-block w-3.5 h-3.5 bg-brandYellow rounded-circle border border-dark"></span>
                    {{ category.title }}
                </h3>
                <div class="row g-4">
                    {% for item in category.items %}
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 bg-light border-0 rounded-3 p-4 shadow-sm hover:shadow-md transition duration-300 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                        <h5 class="fw-bold fs-5 text-brandDark mb-0">{{ item.name }}</h5>
                                        <span class="text-brandDark bg-brandYellow fw-extrabold fs-6 px-3 py-1 rounded-pill shadow-xs border border-brandDark/20">{{ item.price }}</span>
                                    </div>
                                    <p class="text-secondary text-sm leading-relaxed mb-4">{{ item.description }}</p>
                                </div>
                                <div class="text-xs fw-bold text-muted text-uppercase tracking-wider">
                                    ✨ Premium Quality
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</section>
{% endblock %}