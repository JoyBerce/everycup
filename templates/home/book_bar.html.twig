{% extends 'base.html.twig' %}{% block title %}Book the Bar | every cup.{% endblock %}{% block body %}
<section class="page-hero bar-page-hero"><div class="container-xxl px-4"><span class="section-eyebrow">POP-UPS & PRIVATE EVENTS</span><h1>Bring the bar <em>to you.</em></h1><p>A mobile coffee experience for weddings, corporate gatherings, launches, and celebrations.</p></div></section>
<section class="bar-event-hero section-padding"><div class="container-xxl px-4"><div class="row align-items-center g-5"><div class="col-lg-7"><img class="event-image" src="{{ asset('images/1 (3).jpg') }}" alt="Every Cup mobile coffee bar"></div><div class="col-lg-5"><span class="section-eyebrow">MADE FOR YOUR MOMENT</span><h2 class="section-title">A little café magic, <span>anywhere.</span></h2><p class="section-description">Our baristas bring the beans, bar, and warm welcome. Choose a package, tell us about your guests, and we’ll take care of the pour.</p><div class="package-list"><div><strong>☕ From 50 cups</strong><span>Perfect for intimate gatherings</span></div><div><strong>✦ Barista service</strong><span>Two hours of live coffee craft</span></div></div></div></div></div></section>
<section class="booking-section section-padding"><div class="container-xxl px-4"><div class="row g-5"><div class="col-lg-6"><span class="section-eyebrow">CHECK AVAILABILITY</span><h2 class="section-title">Choose your <span>date.</span></h2><div class="booking-calendar"><label for="eventDate">Event date</label><input id="eventDate" type="date" min="{{ 'now'|date('Y-m-d') }}"><p>We’ll confirm availability within one business day.</p></div></div><div class="col-lg-6"><form class="inquiry-form" id="eventInquiry"><input required placeholder="Your name"><input required type="email" placeholder="Email address"><input required placeholder="Event type (wedding, corporate…)" ><textarea required rows="4" placeholder="Tell us about your event"></textarea><button class="btn-primary-custom" type="submit">SEND INQUIRY <span>→</span></button><p class="form-status" id="inquiryStatus"></p></form></div></div></div></section>
{% endblock %}{% block javascripts %}<script>document.getElementById('eventInquiry').addEventListener('submit',e=>{e.preventDefault();document.getElementById('inquiryStatus').textContent='Thanks — we’ll be in touch with a tailored package.'});</script>{% endblock %}
